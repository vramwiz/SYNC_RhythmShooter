unit RhythmFightingDuel;
// v2: advancing encounters and fixed human duels, all contacts on source accents.
interface
uses System.SysUtils,System.JSON,RhythmAudio;
const
  DUEL_SPEED=0.30;
  DUEL_FLOOR=0.79;
  DUEL_BOSS_SWEEP=0.055;
  DUEL_BOSS_FOLLOW=0.035;
  DUEL_BOSS_RETURN=0.14;
type
  TDuelPoint=record
    X,Y:Double;
  end;
  TDuelSection=record
    Start,Ready,Kill,Finish,X:Double;
    Mode,Style,HP:Integer;
  end;
  TDuelHit=record
    Time,Strength,X,Y:Double;
    Source,Section,Enemy,Kind,Role,Side,HP,HeroHP:Integer;
  end;
  TDuelEnemy=record
    Spawn,Ready,Kill,X,Speed:Double;
    First,Last,Side,Kind,Section:Integer;
  end;
  TDuelKey=record
    Time,Hero,Boss:Double;
    Section:Integer;
  end;
  TDuelStage=record
    Time:Double;
    Theme:Integer;
  end;
  TDuelPose=record
    X,Y,Attack,Duck,Turn,Scale:Double;
    Side,Kind,Role,Weapon,Hit:Integer;
  end;
  TDuelStrike=record
    Grip,Hand,Tip:TDuelPoint;
    Side,Weapon,Kind,Hit:Integer;
    Power:Double;
    StraightArm:Boolean;
  end;
  TFightingDuel=class
  private
    FActions,FEnemyActions:TArray<Integer>;
  public
    Events:TArray<TRhythmHit>;
    Hits:TArray<TDuelHit>;
    Enemies:TArray<TDuelEnemy>;
    Sections:TArray<TDuelSection>;
    Keys:TArray<TDuelKey>;
    Stages:TArray<TDuelStage>;
    Goal,Duration:Double;
    Frequency,Excluded:Integer;
  private
    procedure IndexActions;
  public
    class function Build(Audio:TRhythmAudio;const Cancel:TFunc<Boolean>):TFightingDuel; static;
    function ToJSON:TJSONObject;
    class function FromJSON(Root:TJSONObject;Audio:TRhythmAudio):TFightingDuel; static;
    procedure Validate;
    function SectionAt(Time:Double):Integer;
    function HitBefore(Time:Double):Integer;
    function ActionBefore(Time:Double):Integer;
    function EnemyActionBefore(Time:Double):Integer;
    function EnemyBefore(Time:Double):Integer;
    function WorldAt(Time:Double):Double;
    function HeroAt(Time:Double):TDuelPose;
    function BossAt(Time:Double):TDuelPose;
    function EnemyAt(Index:Integer;Time:Double):TDuelPose;
    function HeroStrike(Time:Double;out S:TDuelStrike):Boolean;
    function EnemyStrike(Time:Double;out S:TDuelStrike):Boolean;
    function HealthAt(Time:Double):Double;
    function BossCount:Integer;
    function ThemeAt(Time:Double):Integer;
    procedure CameraAt(Time:Double;out X,Y,Zoom:Double);
    function EndTime:Double;
  end;
implementation
uses System.Math,System.Generics.Collections,RhythmSections;

function Pt(X,Y:Double):TDuelPoint;
begin Result.X:=X;
  Result.Y:=Y;
end;

function Good(V:Double):Boolean;
begin Result:=not IsNan(V) and not IsInfinite(V);
end;

procedure Need(V:Boolean;const S:string);
begin if not V then raise Exception.Create('Fighting duel: '+S);
end;

function TFightingDuel.EndTime:Double;
begin Result:=0;
  if Goal>0 then Result:=Goal+0.90;
end;

function TFightingDuel.SectionAt(Time:Double):Integer;
var
  A,B,M:Integer;
begin A:=0;
  B:=Length(Sections);
  while A<B do begin M:=(A+B) div 2;
    if Sections[M].Start<=Time then A:=M+1 else B:=M;
  end;
  Result:=Max(0,A-1);
end;

function TFightingDuel.HitBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin A:=0;
  B:=Length(Hits);
  while A<B do begin M:=(A+B) div 2;
    if Hits[M].Time<=Time then A:=M+1 else B:=M;
  end;
  Result:=A-1;
end;

function TFightingDuel.ActionBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin A:=0;
  B:=Length(FActions);
  while A<B do begin M:=(A+B) div 2;
    if Hits[FActions[M]].Time<=Time then A:=M+1 else B:=M;
  end;
  Result:=-1;
  if A>0 then Result:=FActions[A-1];
end;

function TFightingDuel.EnemyActionBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin A:=0;
  B:=Length(FEnemyActions);
  while A<B do begin M:=(A+B) div 2;
    if Hits[FEnemyActions[M]].Time<=Time then A:=M+1 else B:=M;
  end;
  Result:=-1;
  if A>0 then Result:=FEnemyActions[A-1];
end;

function TFightingDuel.EnemyBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin A:=0;
  B:=Length(Enemies);
  while A<B do begin M:=(A+B) div 2;
    if Enemies[M].Ready<=Time then A:=M+1 else B:=M;
  end;
  Result:=A-1;
end;

procedure TFightingDuel.IndexActions;
var
  I,N,E:Integer;
begin SetLength(FActions,Length(Hits));
  SetLength(FEnemyActions,Length(Hits));
  N:=0;
  E:=0;
  for I:=0 to High(Hits) do begin if Hits[I].Role<>0 then begin FActions[N]:=I;
      Inc(N);
    end;
    if Hits[I].Role in [2,3,4] then begin FEnemyActions[E]:=I;
      Inc(E);
    end;
  end;
  SetLength(FActions,N);
  SetLength(FEnemyActions,E);
end;

function TFightingDuel.BossCount:Integer;
var
  S:TDuelSection;
begin Result:=0;
  for S in Sections do if S.Mode=1 then Inc(Result);
end;

function TFightingDuel.WorldAt(Time:Double):Double;
var
  S:TDuelSection;
begin Time:=EnsureRange(Time,0.0,EndTime);
  S:=Sections[SectionAt(Min(Time,Goal))];
  Result:=S.X;
  if S.Mode=0 then Result:=Result+DUEL_SPEED*(Min(Time,Goal)-S.Start);
  if Time>Goal then Result:=Result+DUEL_SPEED*(Time-Goal)+1.5*Sqr(Time-Goal);
end;

function TFightingDuel.HeroAt(Time:Double):TDuelPose;
var
  I,A,B,M:Integer;
  H:TDuelHit;
  U,Age,Span:Double;
  K,L:TDuelKey;
begin
  Time:=EnsureRange(Time,0.0,EndTime);
  Result:=Default(TDuelPose);
  Result.X:=WorldAt(Time);
  Result.Y:=DUEL_FLOOR;
  Result.Scale:=1;
  Result.Side:=1;
  Result.Hit:=-1;
  if Time>Goal then Exit;
  if Sections[SectionAt(Time)].Mode=1 then begin A:=0;
    B:=Length(Keys);
    while A<B do begin M:=(A+B) div 2;
      if Keys[M].Time<=Time then A:=M+1 else B:=M;
    end;
    I:=Max(0,A-1);
    K:=Keys[I];
    Result.X:=K.Hero;
    if I<High(Keys) then begin L:=Keys[I+1];
      U:=EnsureRange((Time-K.Time)/Max(1E-12,L.Time-K.Time),0.0,1.0);
      Result.X:=K.Hero+(L.Hero-K.Hero)*U;
    end;
  end;
  I:=ActionBefore(Time);
  if (I<0) or (Abs(Hits[I].Time-Time)>1E-9) then I:=ActionBefore(Time+0.10);
  if I<0 then Exit;
  H:=Hits[I];
  Age:=Time-H.Time;
  if (Age< -0.10) or (Age>0.16) then Exit;
  Result.Hit:=I;
  Result.Kind:=H.Kind;
  Result.Role:=H.Role;
  Result.Side:=H.Side;
  Span:=0.10;
  if H.Role in [1,5] then begin
    if Age<0 then Result.Attack:=0.15+0.35*EnsureRange(1+Age/Span,0.0,1.0) else if Age<=0.025 then Result.Attack:=1 else Result.Attack:=Max(0.0,1-(Age-0.025)/0.135);
    if Sections[H.Section].Mode=0 then Result.X:=Result.X+H.Side*0.055*Result.Attack;
  end else if H.Role=3 then Result.Duck:=0.040*(1-Abs(Age)/0.16)
  else if H.Role=2 then Result.Duck:=0.006;
  if (H.Role=4) and (Age<0) then begin Result.Role:=2;
    Result.Hit:=-1;
  end;
end;

function TFightingDuel.BossAt(Time:Double):TDuelPose;
var
  A,B,M,I:Integer;
  S:TDuelSection;
  K,L:TDuelKey;
  U,Age,EndAge:Double;
  H:TDuelHit;
begin
  Time:=EnsureRange(Time,0.0,EndTime);
  Result:=Default(TDuelPose);
  S:=Sections[SectionAt(Time)];
  if S.Mode<>1 then Exit;
  Result.Scale:=1.40;
  Result.Side:=-1;
  Result.Weapon:=S.Style;
  Result.Y:=DUEL_FLOOR;
  Result.Hit:=-1;
  A:=0;
  B:=Length(Keys);
  while A<B do begin M:=(A+B) div 2;
    if Keys[M].Time<=Time then A:=M+1 else B:=M;
  end;
  I:=Max(0,A-1);
  K:=Keys[I];
  Result.X:=K.Boss;
  if I<High(Keys) then begin L:=Keys[I+1];
    U:=EnsureRange((Time-K.Time)/Max(1E-12,L.Time-K.Time),0.0,1.0);
    Result.X:=K.Boss+(L.Boss-K.Boss)*U;
  end;
  I:=EnemyActionBefore(Time);
  if (I<0) or (Abs(Hits[I].Time-Time)>1E-9) then I:=EnemyActionBefore(Time+0.18);
  if I>=0 then begin H:=Hits[I];
    EndAge:=0.10;
    if (S.Style<>0) or (H.Kind<>1) then EndAge:=DUEL_BOSS_RETURN;
    if (Time<S.Kill) and (H.Section=SectionAt(Time)) and (H.Role in [2,3,4]) and (Time>=H.Time-0.18) and (Time<=H.Time+EndAge) then begin Result.Hit:=I;
      Result.Role:=H.Role;
      Result.Kind:=H.Kind;
    end;
  end;
  if Time>=S.Kill then begin Age:=Time-S.Kill;
    Result.X:=S.X+0.25+Age*1.05;
    Result.Y:=Min(DUEL_FLOOR,DUEL_FLOOR-Age*0.90+1.15*Age*Age);
    Result.Turn:=Age*5;
    Result.Scale:=Result.Scale*Max(0.0,1-Age/0.8);
  end;
end;

function TFightingDuel.EnemyAt(Index:Integer;Time:Double):TDuelPose;
var
  E:TDuelEnemy;
  Age,Power:Double;
  I:Integer;
  H:TDuelHit;
begin E:=Enemies[Index];
  Result:=Default(TDuelPose);
  Result.X:=E.X;
  Result.Y:=DUEL_FLOOR;
  Result.Side:=-E.Side;
  Result.Scale:=1;
  Result.Kind:=E.Kind;
  Result.Hit:=-1;
  if Time<E.Ready then begin if E.Side<0 then Result.X:=E.X-E.Speed*(E.Ready-Time) else Result.X:=E.X+E.Speed*(E.Ready-Time);
  end
  else if Time<=E.Kill then Result.X:=E.X+DUEL_SPEED*(Time-E.Ready)
  else begin Age:=Time-E.Kill;
    Power:=Hits[E.Last].Strength;
    Result.X:=E.X+DUEL_SPEED*(E.Kill-E.Ready)+E.Side*(0.8+Power*0.7)*Age;
    Result.Y:=Min(DUEL_FLOOR,DUEL_FLOOR-Age*(0.5+Power*0.2)+Age*Age);
    Result.Turn:=E.Side*Age*8;
    Result.Scale:=Max(0.0,1-Age/0.75);
  end;
  I:=EnemyActionBefore(Time+0.18);
  if I>=0 then begin H:=Hits[I];
    if (H.Enemy=Index) and (Time>=H.Time-0.18) and (Time<=H.Time+0.10) then begin Result.Hit:=I;
      Result.Role:=H.Role;
      Result.Kind:=H.Kind;
    end;
  end;
end;

function TFightingDuel.HeroStrike(Time:Double;out S:TDuelStrike):Boolean;
var
  P:TDuelPose;
  H:TDuelHit;
  Age:Double;
begin P:=HeroAt(Time);
  S:=Default(TDuelStrike);
  S.Hit:=P.Hit;
  Result:=P.Hit>=0;
  if not Result then Exit;
  H:=Hits[P.Hit];
  Age:=Time-H.Time;
  Result:=H.Role in [1,2,5];
  if not Result then Exit;
  S.Side:=H.Side;
  S.Kind:=H.Kind;
  S.Power:=H.Strength;
  S.Grip:=Pt(P.X+H.Side*0.022,P.Y-0.100+P.Duck);
  if H.Kind=1 then S.Grip:=Pt(P.X,P.Y-0.046);
  S.Tip:=Pt(S.Grip.X+H.Side*0.05,S.Grip.Y+0.02);
  if (Age>=0) and (Age<=0.025) then S.Tip:=Pt(H.X,H.Y)
  else if Age<0 then S.Tip:=Pt(S.Grip.X-H.Side*0.025,S.Grip.Y-0.025)
  else S.Tip:=Pt(S.Grip.X+H.Side*0.075,S.Grip.Y+0.035);
end;

procedure BossArmMotion(const H:TDuelHit;const P,ContactPose:TDuelPose;Time:Double;var S:TDuelStrike);
var
  ContactGrip,IdleHand,IdleTip,FollowHand,FollowTip:TDuelPoint;
  Age,Reach,ArmLength,WeaponLength,Aim,Wind,Follow,Angle,U,FloorAngle:Double;
  function Along(Length,Direction:Double):TDuelPoint;
  begin Result:=Pt(S.Side*Cos(Direction)*Length,Sin(Direction)*Length);
  end;
  function Mix(const A,B:TDuelPoint;Amount:Double):TDuelPoint;
  begin Result:=Pt(A.X+(B.X-A.X)*Amount,A.Y+(B.Y-A.Y)*Amount);
  end;
begin
  // The shoulder matches Person's near arm. Contact reach stays fixed during the swing.
  S.StraightArm:=True;
  Age:=Time-H.Time;
  S.Grip:=Pt(P.X+S.Side*0.020*P.Scale,P.Y-0.106*P.Scale);
  ContactGrip:=Pt(ContactPose.X+S.Side*0.020*ContactPose.Scale,ContactPose.Y-0.106*ContactPose.Scale);
  Reach:=Hypot(H.X-ContactGrip.X,H.Y-ContactGrip.Y);
  Aim:=ArcTan2(H.Y-ContactGrip.Y,S.Side*(H.X-ContactGrip.X));
  WeaponLength:=0.014;
  Wind:=Aim-1.30;
  Follow:=Aim+0.65;
  if S.Weapon=1 then begin WeaponLength:=0.19;
    Wind:=Aim-1.70;
    Follow:=Aim+0.45;
  end
  else if S.Weapon=2 then begin WeaponLength:=0.06;
    Wind:=Aim-1.05;
    Follow:=Aim+0.85;
  end;
  ArmLength:=Max(0.025,Reach-WeaponLength);
  FloorAngle:=ArcSin(EnsureRange((DUEL_FLOOR-0.015-S.Grip.Y)/Max(Reach,1E-8),-1.0,1.0));
  Follow:=Min(Follow,FloorAngle);
  if H.Y>=DUEL_FLOOR-0.005 then Follow:=Aim-0.30;
  IdleHand:=Pt(S.Side*0.023*P.Scale,0.034*P.Scale);
  IdleTip:=Pt(IdleHand.X+S.Side*0.014,IdleHand.Y);
  if S.Weapon=1 then IdleTip:=Pt(IdleHand.X+S.Side*0.04,IdleHand.Y-0.22)
  else if S.Weapon=2 then IdleTip:=Pt(IdleHand.X+S.Side*0.06,IdleHand.Y-0.01);
  if Age< -DUEL_BOSS_SWEEP then begin
    U:=EnsureRange((Age+0.18)/(0.18-DUEL_BOSS_SWEEP),0.0,1.0);
    U:=U*U*(3-2*U);
    S.Hand:=Mix(IdleHand,Along(ArmLength,Wind),U);
    S.Tip:=Mix(IdleTip,Along(Reach,Wind),U);
  end else if Age<=0 then begin
    U:=EnsureRange(1+Age/DUEL_BOSS_SWEEP,0.0,1.0);
    Angle:=Wind+(Aim-Wind)*U*U;
    S.Hand:=Along(ArmLength,Angle);
    S.Tip:=Along(Reach,Angle);
  end else if Age<=DUEL_BOSS_FOLLOW then begin
    U:=Age/DUEL_BOSS_FOLLOW;
    Angle:=Aim+(Follow-Aim)*U;
    S.Hand:=Along(ArmLength,Angle);
    S.Tip:=Along(Reach,Angle);
  end else begin
    U:=EnsureRange((Age-DUEL_BOSS_FOLLOW)/(DUEL_BOSS_RETURN-DUEL_BOSS_FOLLOW),0.0,1.0);
    U:=U*U*(3-2*U);
    FollowHand:=Along(ArmLength,Follow);
    FollowTip:=Along(Reach,Follow);
    S.Hand:=Mix(FollowHand,IdleHand,U);
    S.Tip:=Mix(FollowTip,IdleTip,U);
  end;
  S.Hand:=Pt(S.Grip.X+S.Hand.X,S.Grip.Y+S.Hand.Y);
  S.Tip:=Pt(S.Grip.X+S.Tip.X,S.Grip.Y+S.Tip.Y);
  if Age=0 then S.Tip:=Pt(H.X,H.Y);
end;

function TFightingDuel.EnemyStrike(Time:Double;out S:TDuelStrike):Boolean;
var
  I:Integer;
  H:TDuelHit;
  P:TDuelPose;
  Age,U,EndAge:Double;
begin S:=Default(TDuelStrike);
  I:=EnemyActionBefore(Time);
  if (I<0) or (Abs(Hits[I].Time-Time)>1E-9) then I:=EnemyActionBefore(Time+0.18);
  Result:=I>=0;
  if not Result then Exit;
  H:=Hits[I];
  Age:=Time-H.Time;
  EndAge:=0.10;
  if (Sections[H.Section].Mode=1) and ((Sections[H.Section].Style<>0) or (H.Kind<>1)) then EndAge:=DUEL_BOSS_RETURN;
  Result:=(H.Role in [2,3,4]) and (Age>=-0.18) and (Age<=EndAge);
  if not Result then Exit;
  if Sections[H.Section].Mode=0 then begin if Time>Enemies[H.Enemy].Kill then Exit(False);
  end else if Time>=Sections[H.Section].Kill then Exit(False);
  if Sections[H.Section].Mode=1 then P:=BossAt(Time) else P:=EnemyAt(H.Enemy,Time);
  S.Side:=-H.Side;
  S.Weapon:=P.Weapon;
  S.Kind:=H.Kind;
  S.Hit:=I;
  S.Power:=H.Strength;
  if (Sections[H.Section].Mode=1) and ((S.Weapon<>0) or (S.Kind<>1)) then begin BossArmMotion(H,P,BossAt(H.Time),Time,S);
    Exit;
  end;
  S.Grip:=Pt(P.X+S.Side*0.030,DUEL_FLOOR-0.13);
  if (S.Kind=1) and (S.Weapon=0) then S.Grip:=Pt(P.X,DUEL_FLOOR-0.046);
  U:=EnsureRange(1+Age/0.18,0.0,1.0);
  S.Tip:=Pt(S.Grip.X+(H.X-S.Grip.X)*U,S.Grip.Y+(H.Y-S.Grip.Y)*U);
end;

function TFightingDuel.HealthAt(Time:Double):Double;
var
  I:Integer;
  S:TDuelSection;
begin S:=Sections[SectionAt(Time)];
  Result:=0;
  if S.Mode<>1 then Exit;
  if Time<S.Ready then Exit(1);
  if Time>=S.Kill then Exit(0);
  I:=HitBefore(Time);
  Result:=1;
  if I>=0 then if Hits[I].Section=SectionAt(Time) then Result:=Hits[I].HP/Max(1,S.HP);
end;

function TFightingDuel.ThemeAt(Time:Double):Integer;
var
  I:Integer;
begin Result:=0;
  for I:=0 to High(Stages) do begin if Stages[I].Time>Time then Break;
    Result:=Stages[I].Theme;
  end;
end;

procedure TFightingDuel.CameraAt(Time:Double;out X,Y,Zoom:Double);
var
  P,B:TDuelPose;
  S:TDuelSection;
  Strike:TDuelStrike;
  Lo,Hi,Top,Bottom,Desired,W:Double;
  I:Integer;
begin
  P:=HeroAt(Time);
  S:=Sections[SectionAt(Time)];
  X:=WorldAt(Min(Time,Goal))+0.20;
  Y:=0.66;
  Zoom:=1;
  if S.Mode=0 then Exit;
  B:=BossAt(Time);
  Lo:=Min(P.X-0.08,B.X-0.10);
  Hi:=Max(P.X+0.08,B.X+0.10);
  Top:=Min(P.Y-0.22,B.Y-0.29);
  Bottom:=Max(P.Y+0.04,B.Y+0.10);
  if HeroStrike(Time,Strike) then begin Lo:=Min(Lo,Strike.Tip.X-0.03);
    Hi:=Max(Hi,Strike.Tip.X+0.03);
    Top:=Min(Top,Strike.Tip.Y-0.03);
    Bottom:=Max(Bottom,Strike.Tip.Y+0.03);
  end;
  if EnemyStrike(Time,Strike) then begin Lo:=Min(Lo,Min(Strike.Grip.X,Strike.Tip.X)-0.03);
    Hi:=Max(Hi,Max(Strike.Grip.X,Strike.Tip.X)+0.03);
    Top:=Min(Top,Min(Strike.Grip.Y,Strike.Tip.Y)-0.03);
    Bottom:=Max(Bottom,Max(Strike.Grip.Y,Strike.Tip.Y)+0.03);
  end;
  if EnemyStrike(Time,Strike) then if Strike.StraightArm then begin Lo:=Min(Lo,Strike.Hand.X-0.03);
    Hi:=Max(Hi,Strike.Hand.X+0.03);
    Top:=Min(Top,Strike.Hand.Y-0.03);
    Bottom:=Max(Bottom,Strike.Hand.Y+0.03);
  end;
  if (Time<S.Kill) and (S.Style=1) then Top:=Min(Top,0.42);
  if Time>=S.Kill then begin Lo:=Min(Lo,B.X-0.30);
    Hi:=Max(Hi,B.X+0.30);
    Top:=Min(Top,B.Y-0.30);
    Bottom:=Max(Bottom,B.Y+0.30);
  end;
  I:=ActionBefore(Time+0.16);
  W:=0;
  if I>=0 then W:=Max(0.0,1-Abs(Time-Hits[I].Time)/0.40);
  Desired:=1.25+0.65*W;
  if Time>=S.Kill then Desired:=1.0 else if Time>S.Kill-0.9 then Desired:=2.0;
  Zoom:=Max(0.70,Min(Desired,Min(1.6/(Hi-Lo+0.18),1/(Bottom-Top+0.14))));
  X:=(Lo+Hi)/2;
  Y:=(Top+Bottom)/2+0.16/Zoom;
end;

class function TFightingDuel.Build(Audio:TRhythmAudio;const Cancel:TFunc<Boolean>):TFightingDuel;
var
  SL:TList<TDuelSection>;
  HL:TList<TDuelHit>;
  EL:TList<TDuelEnemy>;
  KL:TList<TDuelKey>;
  TL:TList<TDuelStage>;
  Active:TList<Integer>;
  S:TDuelSection;
  H:TDuelHit;
  E:TDuelEnemy;
  K:TDuelKey;
  Stage:TDuelStage;
  Cue:TRhythmBossCue;
  I,J,N,Q,A,B,BI,CountHP,Remaining,HeroHP:Integer;
  Cursor,X,Last,Gap,Best,Kill,Pre,Post,HeroX,BossX,Next:Double;
  procedure Check;
  begin if Assigned(Cancel) and Cancel() then Abort;
  end;
  procedure AddSection(Start,Ready,Kill,Finish:Double;Mode,Style:Integer);
  begin if Finish<=Start+1E-9 then Exit;
    S:=Default(TDuelSection);
    S.Start:=Start;
    S.Ready:=Ready;
    S.Kill:=Kill;
    S.Finish:=Finish;
    S.X:=X;
    S.Mode:=Mode;
    S.Style:=Style;
    SL.Add(S);
    if Mode=0 then X:=X+DUEL_SPEED*(Finish-Start);
  end;
  procedure Key(Time,HX,BX:Double;Section:Integer);
  begin K.Time:=Time;
    K.Hero:=HX;
    K.Boss:=BX;
    K.Section:=Section;
    if (KL.Count>0) and (Abs(KL[KL.Count-1].Time-Time)<1E-10) then KL[KL.Count-1]:=K else KL.Add(K);
  end;
begin
  Need(Audio<>nil,'audio');
  Check;
  Need(Good(Audio.Duration) and Good(Audio.SoundEnd) and (Audio.Duration>0) and (Audio.SoundEnd>=0) and (Audio.SoundEnd<=Audio.Duration) and (Length(Audio.Hits)<=100000),'audio bounds');
  Result:=TFightingDuel.Create;
  SL:=TList<TDuelSection>.Create;
  HL:=TList<TDuelHit>.Create;
  EL:=TList<TDuelEnemy>.Create;
  KL:=TList<TDuelKey>.Create;
  TL:=TList<TDuelStage>.Create;
  Active:=TList<Integer>.Create;
  try try
      Result.Events:=Copy(Audio.Hits);
      Result.Goal:=Audio.SoundEnd;
      Result.Duration:=Audio.Duration;
      Result.Frequency:=Audio.BossFrequency;
      Last:=-1;
      for I:=0 to High(Audio.Hits) do begin Check;
        Need(Good(Audio.Hits[I].Time) and Good(Audio.Hits[I].Strength) and (Audio.Hits[I].Time>=Last) and (Audio.Hits[I].Time>=0) and (Audio.Hits[I].Time<=Audio.Duration+0.011),'source order');
        Last:=Audio.Hits[I].Time;
      end;
      Cursor:=0;
      X:=0.60;
      BI:=0;
      Stage.Time:=0;
      Stage.Theme:=0;
      TL.Add(Stage);
      for I:=0 to Audio.BossCount-1 do begin Check;
        if BI>=64 then Break;
        Cue:=Audio.BossCue(I);
        A:=Audio.NearestHit(Cue.StartTime+0.75);
        B:=Audio.NearestHit(Cue.KillTime);
        if (A<0) or (B<A+4) then Continue;
        B:=Min(B,High(Audio.Hits));
        while (B>=A) and (Audio.Hits[B].Time>Result.Goal-0.85) do Dec(B);
        if B<A+4 then Continue;
        Best:=-1;
        N:=B;
        for J:=B downto A do begin if Audio.Hits[J].Time<Audio.Hits[B].Time-1.2 then Break;
          if Audio.Hits[J].Strength>Best then begin N:=J;
            Best:=Audio.Hits[J].Strength;
          end;
        end;
        B:=N;
        Kill:=Audio.Hits[B].Time;
        if (Kill>Result.Goal) or (Kill-Audio.Hits[A].Time<3) then Continue;
        Last:=Max(Cursor,Audio.Hits[A].Time-0.75);
        AddSection(Cursor,Cursor,Last,Last,0,0);
        AddSection(Last,Audio.Hits[A].Time,Kill,Min(Result.Goal,Kill+0.80),1,BI mod 3);
        Cursor:=Min(Result.Goal,Kill+0.80);
        Inc(BI);
        if Cue.QuietBoundary and (Cue.KillTime<=Result.Goal) then if Cue.KillTime>TL[TL.Count-1].Time+8 then begin Stage.Time:=Cue.KillTime;
          Stage.Theme:=TL.Count mod 4;
          TL.Add(Stage);
        end;
      end;
      AddSection(Cursor,Cursor,Result.Goal,Max(Result.Goal,0.001),0,0);
      if SL.Count=0 then AddSection(0,0,0,0.001,0,0);
      Result.Sections:=SL.ToArray;
      for I:=0 to High(Audio.Hits) do begin Check;
        if (Result.Goal<=0) or (Audio.Hits[I].Time>Result.Goal+1E-6) then begin Inc(Result.Excluded);
          Continue;
        end;
        H:=Default(TDuelHit);
        H.Time:=Audio.Hits[I].Time;
        H.Strength:=EnsureRange(Audio.Hits[I].Strength,0.0,1.0);
        H.Source:=I;
        H.Section:=Result.SectionAt(H.Time);
        H.Enemy:=-1;
        H.Side:=1;
        HL.Add(H);
      end;
      Result.Hits:=HL.ToArray;
      I:=0;
      while I<Length(Result.Hits) do begin Check;
        H:=Result.Hits[I];
        S:=Result.Sections[H.Section];
        if S.Mode=1 then begin Inc(I);
          Continue;
        end;
        J:=I;
        while J<High(Result.Hits) do begin if Result.Hits[J+1].Section<>H.Section then Break;
          if (Result.Hits[J+1].Time-H.Time>0.32+1E-9) or (Result.Hits[J+1].Time-Result.Hits[J].Time>0.20+1E-9) then Break;
          Inc(J);
        end;
        E:=Default(TDuelEnemy);
        E.First:=I;
        E.Last:=J;
        E.Ready:=H.Time;
        E.Kill:=Result.Hits[J].Time;
        E.Spawn:=Max(S.Start,H.Time-2);
        E.Section:=H.Section;
        E.Side:=1;
        if EL.Count mod 3=2 then E.Side:=-1;
        E.Kind:=EL.Count mod 3;
        E.X:=Result.WorldAt(H.Time)+E.Side*0.16;
        E.Speed:=0.78+0.12*E.Kind;
        EL.Add(E);
        for Q:=I to J do begin H:=Result.Hits[Q];
          H.Enemy:=EL.Count-1;
          H.Side:=E.Side;
          H.Role:=1;
          H.Kind:=E.Kind mod 2;
          if H.Strength>=0.82 then H.Kind:=2;
          H.X:=E.X+DUEL_SPEED*(H.Time-E.Ready)-E.Side*0.029;
          H.Y:=0.690;
          if H.Kind=1 then H.Y:=0.724;
          if (Q=I) and (J>I) then begin H.Role:=2;
            H.X:=Result.WorldAt(H.Time)+E.Side*0.050;
            H.Y:=0.690;
            H.Kind:=0;
          end;
          Result.Hits[Q]:=H;
        end;
        // Simultaneous source accents share one body contact; retain every source row.
        for Q:=I to J-1 do if Result.Hits[Q].Time=Result.Hits[Q+1].Time then begin
          H:=Result.Hits[Q];
          if (H.Role=2) and (H.Time<E.Kill) then begin Result.Hits[Q+1].Role:=2;
            Result.Hits[Q+1].Kind:=0;
            Result.Hits[Q+1].X:=H.X;
            Result.Hits[Q+1].Y:=H.Y;
          end;
          H.Role:=0;
          Result.Hits[Q]:=H;
        end;
        I:=J+1;
        if EL.Count>40000 then raise Exception.Create('Fighting duel enemy limit');
      end;
      Result.Enemies:=EL.ToArray;
      for I:=0 to High(Result.Sections) do begin Check;
        S:=Result.Sections[I];
        if S.Mode<>1 then Continue;
        Active.Clear;
        Last:=S.Ready-1;
        for J:=Max(0,Result.HitBefore(S.Ready-1E-8)+1) to Result.HitBefore(S.Kill) do begin H:=Result.Hits[J];
          if H.Section<>I then Continue;
          Gap:=0.34;
          if S.Style=1 then Gap:=0.48;
          if S.Style=2 then Gap:=0.28;
          if (H.Time-Last>=Gap) and (H.Time<S.Kill-0.30) then begin Active.Add(J);
            Last:=H.Time;
          end;
        end;
        N:=Result.HitBefore(S.Kill);
        if N>=0 then if (Result.Hits[N].Section=I) then Active.Add(N);
        Need(Active.Count>0,'boss contacts');
        CountHP:=0;
        HeroHP:=5;
        for J:=0 to Active.Count-1 do begin H:=Result.Hits[Active[J]];
          H.Role:=1;
          case J mod 8 of 1,7:H.Role:=2;
            3:H.Role:=3;
            5:H.Role:=4;
          end;
          if J>=Active.Count-3 then H.Role:=1;
          if J=Active.Count-1 then H.Role:=5;
          H.Kind:=(J div 2) mod 2;
          if H.Role=5 then H.Kind:=2;
          if H.Role in [1,5] then Inc(CountHP);
          if H.Role=4 then HeroHP:=Max(1,HeroHP-1);
          H.HeroHP:=HeroHP;
          Result.Hits[Active[J]]:=H;
        end;
        S.HP:=CountHP;
        Result.Sections[I]:=S;
        Remaining:=CountHP;
        Key(S.Start,S.X,S.X+0.95,I);
        Key(S.Ready-0.20,S.X,S.X+0.38,I);
        Last:=S.Ready-0.20;
        for J:=0 to Active.Count-1 do begin H:=Result.Hits[Active[J]];
          Next:=S.Finish;
          if J<Active.Count-1 then Next:=Result.Hits[Active[J+1]].Time;
          Pre:=Min(0.20,(H.Time-Last)*0.42);
          Post:=Min(0.20,(Next-H.Time)*0.40);
          HeroX:=S.X;
          BossX:=S.X+0.25;
          if H.Role in [1,5] then HeroX:=S.X+0.035 else if H.Role=2 then HeroX:=S.X-0.015 else if H.Role=3 then HeroX:=S.X-0.10;
          if H.Role in [2,3,4] then case S.Style of 0:begin BossX:=S.X+0.25;
              if H.Role=3 then BossX:=S.X+0.21;
            end;
            1:BossX:=S.X+0.38;
            else BossX:=S.X+0.21;
          end;
          Key(H.Time-Pre,S.X-0.045,BossX+0.10,I);
          Key(H.Time,HeroX,BossX,I);
          Key(H.Time+Min(0.025,Post*0.25),HeroX,BossX,I);
          if H.Role=4 then Key(H.Time+Post,S.X-0.11,BossX+0.09,I) else Key(H.Time+Post,S.X-0.025,BossX+0.12,I);
          Last:=H.Time;
          if H.Role in [1,5] then begin H.X:=BossX-0.041;
            H.Y:=0.690;
            if H.Kind=1 then begin H.X:=BossX-0.028;
              H.Y:=0.724;
            end;
            Dec(Remaining);
          end
          else begin H.X:=HeroX+0.050;
            H.Y:=0.690;
            if H.Role=4 then H.X:=HeroX+0.025;
            if H.Role=3 then begin H.X:=S.X;
              H.Y:=0.645;
              if S.Style=1 then H.Y:=DUEL_FLOOR;
            end;
          end;
          H.HP:=Remaining;
          Result.Hits[Active[J]]:=H;
        end;
        Key(S.Finish,S.X,S.X+0.38,I);
        Remaining:=S.HP;
        HeroHP:=5;
        for J:=Max(0,Result.HitBefore(S.Start-1E-8)+1) to Result.HitBefore(S.Finish) do begin H:=Result.Hits[J];
          if H.Section<>I then Continue;
          if H.Role in [1,5] then Dec(Remaining);
          if H.Role=4 then HeroHP:=Max(1,HeroHP-1);
          H.HP:=Remaining;
          H.HeroHP:=HeroHP;
          Result.Hits[J]:=H;
        end;
      end;
      Result.Keys:=KL.ToArray;
      Result.Stages:=TL.ToArray;
      Result.IndexActions;
      Result.Validate;
    except Result.Free;
      raise;
    end;
  finally Active.Free;
    TL.Free;
    KL.Free;
    EL.Free;
    HL.Free;
    SL.Free;
  end;
end;

procedure TFightingDuel.Validate;
var
  I,J,N:Integer;
  S:TDuelSection;
  H:TDuelHit;
  E:TDuelEnemy;
  K:TDuelKey;
  P:TDuelPose;
  Strike:TDuelStrike;
  Last,HP:Double;
begin
  Need(Good(Goal) and Good(Duration) and (Goal>=0) and (Goal<=Duration) and (Frequency>=0) and (Frequency<=100),'header');
  Need((Length(Sections)>0) and (Length(Sections)<=129) and (Length(Hits)<=100000) and (Length(Enemies)<=40000) and (Length(Keys)<=400000) and (Length(Stages)<=65),'limits');
  Need((Excluded>=0) and (Length(Hits)+Excluded=Length(Events)),'source count');
  Need((Length(Stages)>0) and (Stages[0].Time=0),'first stage');
  Need((BossCount=0) or (Length(Keys)>0),'boss keys');
  if Frequency=0 then Need(BossCount=0,'boss disabled');
  Last:=-1;
  for I:=0 to High(Events) do begin Need(Good(Events[I].Time) and Good(Events[I].Strength) and (Events[I].Time>=0) and (Events[I].Time>=Last) and (Events[I].Time<=Duration+0.011),'source event');
    Last:=Events[I].Time;
  end;
  Last:=0;
  for I:=0 to High(Sections) do begin S:=Sections[I];
    Need(Good(S.Start) and Good(S.Finish) and Good(S.X) and (Abs(S.Start-Last)<1E-7) and (S.Finish>S.Start) and (S.Mode in [0,1]) and (S.Style in [0,1,2]),'section');
    Last:=S.Finish;
    if I>0 then Need(Abs(S.X-(Sections[I-1].X+Ord(Sections[I-1].Mode=0)*DUEL_SPEED*(Sections[I-1].Finish-Sections[I-1].Start)))<1E-7,'world continuity');
  end;
  Need(Abs(Last-Max(0.001,Goal))<1E-7,'whole song');
  Last:=-1;
  for I:=0 to High(Stages) do begin Need(Good(Stages[I].Time) and (Stages[I].Time>=0) and (Stages[I].Time<=Goal+1E-6) and (Stages[I].Theme in [0,1,2,3]) and (Stages[I].Time>Last),'stage boundary');
    Last:=Stages[I].Time;
  end;
  Last:=-1;
  for K in Keys do begin Need(Good(K.Time) and Good(K.Hero) and Good(K.Boss) and (K.Time>Last) and (K.Section>=0) and (K.Section<Length(Sections)),'keys');
    Last:=K.Time;
  end;
  for I:=0 to High(Enemies) do begin E:=Enemies[I];
    Need((E.First>=0) and (E.Last<Length(Hits)) and (E.Last>=E.First) and ((E.Side=-1) or (E.Side=1)) and Good(E.X) and (E.Speed>DUEL_SPEED) and (E.Spawn<=E.Ready) and (E.Kill>=E.Ready),'enemy');
  end;
  Last:=-1;
  for I:=0 to High(Hits) do begin H:=Hits[I];
    Need(Good(H.Time) and Good(H.X) and Good(H.Y) and Good(H.Strength) and (H.Time>=Last) and (H.Time<=Goal+1E-6) and (H.Source=I) and (H.Time=Events[H.Source].Time) and (H.Section=SectionAt(H.Time)) and (H.Role in [0,1,2,3,4,5]) and (H.Kind in [0,1,2]) and ((H.Side=-1) or (H.Side=1)) and (H.Strength>=0) and (H.Strength<=1),'hit');
    Last:=H.Time;
    if Sections[H.Section].Mode=0 then Need((H.Enemy>=0) and (H.Enemy<Length(Enemies)),'normal target before pose');
    if H.Role in [1,5] then begin Need(HeroStrike(H.Time,Strike),'hero strike');
      Need(Hypot(Strike.Tip.X-H.X,Strike.Tip.Y-H.Y)<1E-7,'hero contact');
      Need(Hypot(Strike.Tip.X-Strike.Grip.X,Strike.Tip.Y-Strike.Grip.Y)<0.22,'hero reach');
    end;
    if H.Role in [2,3,4] then begin Need(EnemyStrike(H.Time,Strike),'enemy strike');
      Need(Hypot(Strike.Tip.X-H.X,Strike.Tip.Y-H.Y)<1E-7,'enemy contact');
      Need(Hypot(Strike.Tip.X-Strike.Grip.X,Strike.Tip.Y-Strike.Grip.Y)<0.40,'weapon reach');
    end;
    if Sections[H.Section].Mode=0 then begin Need((H.Enemy>=0) and (H.Enemy<Length(Enemies)),'normal target');
      E:=Enemies[H.Enemy];
      if H.Role=1 then begin P:=EnemyAt(H.Enemy,H.Time);
        Need(Abs(H.X-(P.X-H.Side*0.029))<1E-7,'normal body surface');
      end;
    end;
  end;
  for I:=0 to High(Sections) do if Sections[I].Mode=1 then begin S:=Sections[I];
    N:=0;
    HP:=S.HP;
    for J:=0 to High(Hits) do begin H:=Hits[J];
      if H.Section<>I then Continue;
      Need(H.HP<=HP,'HP reversal');
      HP:=H.HP;
      if H.Role=5 then begin Inc(N);
        Need(H.Time=S.Kill,'finisher clock');
      end;
      if H.Time>S.Kill then Need(H.Role=0,'attack after defeat');
    end;
    Need((N=1) and (HP=0),'finisher/HP');
  end;
end;

function TFightingDuel.ToJSON:TJSONObject;
var
  A,R:TJSONArray;
  E:TRhythmHit;
  H:TDuelHit;
  N:TDuelEnemy;
  S:TDuelSection;
  K:TDuelKey;
  T:TDuelStage;
  procedure Row(const V:array of Double);
  var
    D:Double;
    B:UInt64;
  begin R:=TJSONArray.Create;
    A.AddElement(R);
    for D in V do begin Move(D,B,8);
      R.Add(IntToHex(B,16));
    end;
  end;
begin Result:=TJSONObject.Create;
  Result.AddPair('policy','advancing-human-duel-v2');
  Result.AddPair('duration',TJSONNumber.Create(Duration));
  Result.AddPair('goal',TJSONNumber.Create(Goal));
  Result.AddPair('frequency',TJSONNumber.Create(Frequency));
  Result.AddPair('excluded',TJSONNumber.Create(Excluded));
  A:=TJSONArray.Create;
  Result.AddPair('events',A);
  for E in Events do Row([E.Time,E.Strength]);
  A:=TJSONArray.Create;
  Result.AddPair('sections',A);
  for S in Sections do Row([S.Start,S.Ready,S.Kill,S.Finish,S.X,S.Mode,S.Style,S.HP]);
  A:=TJSONArray.Create;
  Result.AddPair('hits',A);
  for H in Hits do Row([H.Time,H.Strength,H.X,H.Y,H.Source,H.Section,H.Enemy,H.Kind,H.Role,H.Side,H.HP,H.HeroHP]);
  A:=TJSONArray.Create;
  Result.AddPair('enemies',A);
  for N in Enemies do Row([N.Spawn,N.Ready,N.Kill,N.X,N.Speed,N.First,N.Last,N.Side,N.Kind,N.Section]);
  A:=TJSONArray.Create;
  Result.AddPair('keys',A);
  for K in Keys do Row([K.Time,K.Hero,K.Boss,K.Section]);
  A:=TJSONArray.Create;
  Result.AddPair('stages',A);
  for T in Stages do Row([T.Time,T.Theme]);
end;

class function TFightingDuel.FromJSON(Root:TJSONObject;Audio:TRhythmAudio):TFightingDuel;
var
  A,R:TJSONArray;
  I:Integer;
  function Table(const Name:string;Limit:Integer):TJSONArray;
  begin Result:=Root.GetValue<TJSONArray>(Name);
    Need((Result<>nil) and (Result.Count<=Limit),'JSON '+Name);
  end;
  procedure Row(N:Integer);
  begin R:=A.Items[I] as TJSONArray;
    Need(R.Count=N,'JSON columns');
  end;
  function V(N:Integer):Double;
  var
    Bits:UInt64;
  begin Need((R.Items[N] is TJSONString) and (Length(R.Items[N].Value)=16) and TryStrToUInt64('$'+R.Items[N].Value,Bits),'binary64');
    Move(Bits,Result,8);
    Need(Good(Result),'finite JSON');
  end;
  function Int(N,Low,High:Integer):Integer;
  var
    D:Double;
  begin D:=V(N);
    Need((D>=Low) and (D<=High) and (Frac(D)=0),'integer');
    Result:=Trunc(D);
  end;
begin Need((Root<>nil) and (Root.GetValue<string>('policy','')='advancing-human-duel-v2'),'JSON policy');
  Result:=TFightingDuel.Create;
  try Result.Goal:=Root.GetValue<Double>('goal');
    Result.Duration:=Root.GetValue<Double>('duration');
    Result.Frequency:=Root.GetValue<Integer>('frequency');
    Result.Excluded:=Root.GetValue<Integer>('excluded');
    Need((Abs(Result.Goal-Audio.SoundEnd)<1E-6) and (Abs(Result.Duration-Audio.Duration)<1E-6),'audio identity');
    A:=Table('events',100000);
    SetLength(Result.Events,A.Count);
    Need(A.Count=Length(Audio.Hits),'event count');
    for I:=0 to A.Count-1 do begin Row(2);
      Result.Events[I].Time:=V(0);
      Result.Events[I].Strength:=V(1);
    end;
    A:=Table('sections',129);
    SetLength(Result.Sections,A.Count);
    for I:=0 to A.Count-1 do begin Row(8);
      with Result.Sections[I] do begin Start:=V(0);
        Ready:=V(1);
        Kill:=V(2);
        Finish:=V(3);
        X:=V(4);
        Mode:=Int(5,0,1);
        Style:=Int(6,0,2);
        HP:=Int(7,0,100000);
      end;
    end;
    A:=Table('hits',100000);
    SetLength(Result.Hits,A.Count);
    for I:=0 to A.Count-1 do begin Row(12);
      with Result.Hits[I] do begin Time:=V(0);
        Strength:=V(1);
        X:=V(2);
        Y:=V(3);
        Source:=Int(4,0,100000);
        Section:=Int(5,0,128);
        Enemy:=Int(6,-1,40000);
        Kind:=Int(7,0,2);
        Role:=Int(8,0,5);
        Side:=Int(9,-1,1);
        HP:=Int(10,0,100000);
        HeroHP:=Int(11,0,5);
      end;
    end;
    A:=Table('enemies',40000);
    SetLength(Result.Enemies,A.Count);
    for I:=0 to A.Count-1 do begin Row(10);
      with Result.Enemies[I] do begin Spawn:=V(0);
        Ready:=V(1);
        Kill:=V(2);
        X:=V(3);
        Speed:=V(4);
        First:=Int(5,0,100000);
        Last:=Int(6,0,100000);
        Side:=Int(7,-1,1);
        Kind:=Int(8,0,2);
        Section:=Int(9,0,128);
      end;
    end;
    A:=Table('keys',400000);
    SetLength(Result.Keys,A.Count);
    for I:=0 to A.Count-1 do begin Row(4);
      with Result.Keys[I] do begin Time:=V(0);
        Hero:=V(1);
        Boss:=V(2);
        Section:=Int(3,0,128);
      end;
    end;
    A:=Table('stages',65);
    SetLength(Result.Stages,A.Count);
    for I:=0 to A.Count-1 do begin Row(2);
      Result.Stages[I].Time:=V(0);
      Result.Stages[I].Theme:=Int(1,0,3);
    end;
    Result.IndexActions;
    Result.Validate;
  except Result.Free;
    raise;
  end;
end;
end.
