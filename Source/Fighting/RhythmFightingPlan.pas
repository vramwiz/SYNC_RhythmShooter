unit RhythmFightingPlan;
// Every impact is an immutable source accent. Only preparation constructs fights.
interface
uses System.SysUtils,RhythmAudio,RhythmPlanRef,RhythmFightingDuel;
type
  TFightPoint=record
    X,Y:Double;
  end;
  TFightHit=record
    Time,Strength:Double;
    Source,Enemy,Kind,Side:Integer;
    Contact:TFightPoint;
  end;
  TFightEnemy=record
    FirstHit,LastHit,Side,Kind,Boss:Integer;
    Spawn,Ready,Kill,X,Y,Speed:Double;
  end;
  TFightBoss=record
    Start,Ready,Kill,Finish:Double;
    Side,FirstHit,LastHit,HP:Integer;
    Purge:array[0..2] of Double;
  end;
  TFightVolley=record
    Launch,Near,Finish:Double;
    Origin,Target:TFightPoint;
    Count,Mode,Side,Enemy:Integer;
  end;
  TFightFocus=record
    First,Last,Peak,Zoom,Side:Double;
    Kind:Integer;
  end;
  TFightStage=record
    Time:Double;
    Theme:Integer;
  end;
  TFightPose=record
    X,Y,Lean,Duck,Guard,Graze,Attack,ContactX,ContactY:Double;
    Side,Kind,Enemy:Integer;
  end;
  TFightingPlan=class
  private
    FAction:TFightingDuel;
    FRecipeVersion:Integer;
    FEvents:TArray<TRhythmHit>;
    FHits:TArray<TFightHit>;
    FEnemies:TArray<TFightEnemy>;
    FBosses:TArray<TFightBoss>;
    FVolleys:TArray<TFightVolley>;
    FFocus:TArray<TFightFocus>;
    FStages:TArray<TFightStage>;
    FDuration,FGoal,FEnd,FEntry:Double;
    FFrequency,FExcluded:Integer;
    class function BuildLegacy(Audio:TRhythmAudio;const Cancel:TFunc<Boolean>):TFightingPlan; static;
    procedure Validate;
    function GetCount:Integer;
    function GetPulseCount:Integer;
    function GetBossCount:Integer;
    function GetEnemyCount:Integer;
    function GetVolleyCount:Integer;
    function GetStageCount:Integer;
    function GetHit(I:Integer):TFightHit;
    function GetEnemy(I:Integer):TFightEnemy;
    function GetBoss(I:Integer):TFightBoss;
    function GetVolley(I:Integer):TFightVolley;
    function GetStage(I:Integer):TFightStage;
  public
    destructor Destroy; override;
    property Action:TFightingDuel read FAction;
    property RecipeVersion:Integer read FRecipeVersion;
    class function Build(Audio:TRhythmAudio;const Cancel:TFunc<Boolean> = nil):TFightingPlan; static;
    procedure Save(var Ref:TRhythmPlanRef;Audio:TRhythmAudio);
    class function Load(const Ref:TRhythmPlanRef;Audio:TRhythmAudio;Direction:Integer):TFightingPlan; static;
    class function LoadAudioMetadata(const Ref:TRhythmPlanRef;const Source:string;Direction:Integer):TRhythmAudio; static;
    function HitBefore(Time:Double):Integer;
    function EnemyBefore(Time:Double):Integer;
    function VolleyBefore(Time:Double):Integer;
    function BossAt(Time:Double):Integer;
    function HeroBase(Time:Double):Double;
    function HeroAt(Time:Double):TFightPose;
    function EnemyAt(Index:Integer;Time:Double):TFightPoint;
    function BossHealth(Index:Integer;Time:Double):Double;
    function BossCenter(Index:Integer;Time:Double):TFightPoint;
    function ShotAt(Index,Shot:Integer;Time:Double;out P:TFightPoint;out Alpha:Double):Boolean;
    procedure CameraAt(Time:Double;out CenterX,CenterY,Zoom:Double);
    function ThemeAt(Time:Double):Integer;
    property Count:Integer read GetCount;
    property PulseCount:Integer read GetPulseCount;
    property BossCount:Integer read GetBossCount;
    property EnemyCount:Integer read GetEnemyCount;
    property VolleyCount:Integer read GetVolleyCount;
    property StageCount:Integer read GetStageCount;
    property Hit[I:Integer]:TFightHit read GetHit;
    property Enemy[I:Integer]:TFightEnemy read GetEnemy;
    property Boss[I:Integer]:TFightBoss read GetBoss;
    property Volley[I:Integer]:TFightVolley read GetVolley;
    property Stage[I:Integer]:TFightStage read GetStage;
    property EndTime:Double read FEnd;
    property GoalTime:Double read FGoal;
    property BossFrequency:Integer read FFrequency;
  end;
implementation
uses System.Math,System.JSON,System.Generics.Collections,RhythmStyles,RhythmSections,RhythmPreparedData;

destructor TFightingPlan.Destroy;
begin FAction.Free;
  inherited;
end;

class function TFightingPlan.Build(Audio:TRhythmAudio;const Cancel:TFunc<Boolean>):TFightingPlan;
begin Result:=TFightingPlan.Create;
  try Result.FRecipeVersion:=2;
    Result.FAction:=TFightingDuel.Build(Audio,Cancel);
    Result.FGoal:=Result.FAction.Goal;
    Result.FEnd:=Result.FAction.EndTime;
    Result.FDuration:=Result.FAction.Duration;
    Result.FFrequency:=Result.FAction.Frequency;
  except Result.Free;
    raise;
  end;
end;

function Point(X,Y:Double):TFightPoint;
begin Result.X:=X;
  Result.Y:=Y;
end;

function Finite(V:Double):Boolean;
begin Result:=not IsNan(V) and not IsInfinite(V);
end;

function Smooth(V:Double):Double;
begin V:=EnsureRange(V,0.0,1.0);
  Result:=V*V*(3-2*V);
end;

function BaseX(Time:Double):Double;
begin Result:=0.80+0.045*Sin(Time*0.35);
end;

function TFightingPlan.GetCount:Integer;
begin if FAction<>nil then Exit(Length(FAction.Hits));
  Result:=Length(FHits);
end;

function TFightingPlan.GetPulseCount:Integer;
begin if FAction<>nil then Exit(Length(FAction.Events));
  Result:=Length(FEvents);
end;

function TFightingPlan.GetBossCount:Integer;
begin if FAction<>nil then Exit(FAction.BossCount);
  Result:=Length(FBosses);
end;

function TFightingPlan.GetEnemyCount:Integer;
begin if FAction<>nil then Exit(Length(FAction.Enemies));
  Result:=Length(FEnemies);
end;

function TFightingPlan.GetVolleyCount:Integer;
begin Result:=Length(FVolleys);
end;

function TFightingPlan.GetStageCount:Integer;
begin if FAction<>nil then Exit(Length(FAction.Stages));
  Result:=Length(FStages);
end;

function TFightingPlan.GetHit(I:Integer):TFightHit;
var
  H:TDuelHit;
begin if FAction<>nil then begin H:=FAction.Hits[I];
    Result:=Default(TFightHit);
    Result.Time:=H.Time;
    Result.Strength:=H.Strength;
    Result.Source:=H.Source;
    Result.Enemy:=H.Enemy;
    Result.Kind:=H.Kind;
    Result.Side:=H.Side;
    Result.Contact.X:=H.X;
    Result.Contact.Y:=H.Y;
    Exit;
  end;
  Result:=FHits[I];
end;

function TFightingPlan.GetEnemy(I:Integer):TFightEnemy;
var
  E:TDuelEnemy;
begin if FAction<>nil then begin E:=FAction.Enemies[I];
    Result:=Default(TFightEnemy);
    Result.FirstHit:=E.First;
    Result.LastHit:=E.Last;
    Result.Side:=E.Side;
    Result.Kind:=E.Kind;
    Result.Boss:=-1;
    Result.Spawn:=E.Spawn;
    Result.Ready:=E.Ready;
    Result.Kill:=E.Kill;
    Result.X:=E.X;
    Result.Y:=DUEL_FLOOR;
    Result.Speed:=E.Speed;
    Exit;
  end;
  Result:=FEnemies[I];
end;

function TFightingPlan.GetBoss(I:Integer):TFightBoss;
var
  S:TDuelSection;
  N:Integer;
begin if FAction<>nil then begin Result:=Default(TFightBoss);
    N:=0;
    for S in FAction.Sections do if S.Mode=1 then begin if N=I then begin Result.Start:=S.Start;
        Result.Ready:=S.Ready;
        Result.Kill:=S.Kill;
        Result.Finish:=S.Finish;
        Result.Side:=1;
        Result.HP:=S.HP;
        Result.FirstHit:=FAction.HitBefore(S.Ready-1E-8)+1;
        Result.LastHit:=FAction.HitBefore(S.Kill);
        Exit;
      end;
      Inc(N);
    end;
    raise EArgumentOutOfRangeException.Create('Boss');
  end;
  Result:=FBosses[I];
end;

function TFightingPlan.GetVolley(I:Integer):TFightVolley;
begin Result:=FVolleys[I];
end;

function TFightingPlan.GetStage(I:Integer):TFightStage;
begin if FAction<>nil then begin Result.Time:=FAction.Stages[I].Time;
    Result.Theme:=FAction.Stages[I].Theme;
    Exit;
  end;
  Result:=FStages[I];
end;

function TFightingPlan.HitBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin if FAction<>nil then Exit(FAction.HitBefore(Time));
  A:=0;
  B:=Count;
  while A<B do begin M:=(A+B) div 2;
    if FHits[M].Time<=Time then A:=M+1 else B:=M;
  end;
  Result:=A-1;
end;

function TFightingPlan.EnemyBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin if FAction<>nil then Exit(FAction.EnemyBefore(Time));
  A:=0;
  B:=EnemyCount;
  while A<B do begin M:=(A+B) div 2;
    if FEnemies[M].Ready<=Time then A:=M+1 else B:=M;
  end;
  Result:=A-1;
end;

function TFightingPlan.VolleyBefore(Time:Double):Integer;
var
  A,B,M:Integer;
begin A:=0;
  B:=VolleyCount;
  while A<B do begin M:=(A+B) div 2;
    if FVolleys[M].Launch<=Time then A:=M+1 else B:=M;
  end;
  Result:=A-1;
end;

function TFightingPlan.HeroBase(Time:Double):Double;
begin if FAction<>nil then Exit(FAction.WorldAt(Time));
  Result:=BaseX(EnsureRange(Time,0.0,FEnd));
end;

function TFightingPlan.BossAt(Time:Double):Integer;
var
  I:Integer;
begin if FAction<>nil then begin Result:=-1;
    for I:=0 to BossCount-1 do if (Time>=GetBoss(I).Start) and (Time<GetBoss(I).Finish) then Exit(I);
    Exit;
  end;
  Result:=-1;
  for I:=0 to BossCount-1 do if (Time>=FBosses[I].Start) and (Time<FBosses[I].Finish) then Exit(I);
end;

function TFightingPlan.BossCenter(Index:Integer;Time:Double):TFightPoint;
var
  B:TFightBoss;
  U:Double;
  P:TDuelPose;
begin if FAction<>nil then begin B:=GetBoss(Index);
    P:=FAction.BossAt(EnsureRange(Time,B.Start,B.Finish-1E-8));
    Result:=Point(P.X,P.Y);
    Exit;
  end;
  B:=FBosses[Index];
  U:=1-Smooth((Time-B.Start)/Max(0.05,B.Ready-B.Start));
  Result:=Point(BaseX(Time)+B.Side*(0.38+0.85*U),0.79);
end;

function TFightingPlan.BossHealth(Index:Integer;Time:Double):Double;
var
  B:TFightBoss;
  N:Integer;
begin if FAction<>nil then begin B:=GetBoss(Index);
    if Time<B.Ready then Exit(1);
    if Time>=B.Kill then Exit(0);
    Exit(FAction.HealthAt(Time));
  end;
  B:=FBosses[Index];
  if Time>=B.Kill then Exit(0);
  N:=EnsureRange(HitBefore(Time)-B.FirstHit+1,0,B.HP);
  Result:=1-N/Max(1,B.HP);
end;

class function TFightingPlan.BuildLegacy(Audio:TRhythmAudio;const Cancel:TFunc<Boolean>):TFightingPlan;
var
  Hits:TList<TFightHit>;
  Enemies:TList<TFightEnemy>;
  Bosses:TList<TFightBoss>;
  Volleys:TList<TFightVolley>;
  Focus:TList<TFightFocus>;
  Stages:TList<TFightStage>;
  I,J,K,N,A,B,BI,Side:Integer;
  H:TFightHit;
  E:TFightEnemy;
  Boss:TFightBoss;
  V:TFightVolley;
  F:TFightFocus;
  S:TFightStage;
  Cue:TRhythmBossCue;
  Last,Strength,LastFocus,Boundary:Double;
  procedure Check;
  begin if Assigned(Cancel) and Cancel() then Abort;
  end;
  function HitBoss(Time:Double):Integer;
  var
    K:Integer;
  begin Result:=-1;
    for K:=0 to Bosses.Count-1 do if (Time>=Bosses[K].Ready) and (Time<=Bosses[K].Kill) then Exit(K);
  end;
begin
  if Audio=nil then raise EArgumentNilException.Create('Audio');
  Check;
  if not Finite(Audio.Duration) or not Finite(Audio.SoundEnd) or (Audio.Duration<=0) or (Audio.SoundEnd<0) or (Audio.SoundEnd>Audio.Duration) or (Length(Audio.Hits)>100000) then raise Exception.Create('Invalid fighting audio');
  Result:=TFightingPlan.Create;
  Hits:=nil;
  Enemies:=nil;
  Bosses:=nil;
  Volleys:=nil;
  Focus:=nil;
  Stages:=nil;
  try
    Hits:=TList<TFightHit>.Create;
    Enemies:=TList<TFightEnemy>.Create;
    Bosses:=TList<TFightBoss>.Create;
    Volleys:=TList<TFightVolley>.Create;
    Focus:=TList<TFightFocus>.Create;
    Stages:=TList<TFightStage>.Create;
    Result.FDuration:=Audio.Duration;
    Result.FGoal:=Audio.SoundEnd;
    Result.FFrequency:=Audio.BossFrequency;
    Result.FEvents:=Copy(Audio.Hits);
    Last:=-1;
    for I:=0 to High(Audio.Hits) do begin Check;
      if not Finite(Audio.Hits[I].Time) or not Finite(Audio.Hits[I].Strength) or (Audio.Hits[I].Time<Last) or (Audio.Hits[I].Time<0) or (Audio.Hits[I].Time>Audio.Duration+0.011) then raise Exception.Create('Invalid fighting event');
      Last:=Audio.Hits[I].Time;
      if (Audio.SoundEnd<=0) or (Last>Audio.SoundEnd+1E-6) then begin Inc(Result.FExcluded);
        Continue;
      end;
      H:=Default(TFightHit);
      H.Time:=Last;
      H.Strength:=EnsureRange(Audio.Hits[I].Strength,0.0,1.0);
      H.Source:=I;
      Hits.Add(H);
    end;
    Result.FHits:=Hits.ToArray;
    if Audio.SoundEnd>0 then Result.FEnd:=Audio.SoundEnd+0.90;
    Result.FEntry:=0;
    if Hits.Count>0 then Result.FEntry:=Min(0.65,Max(0.0,Hits[0].Time-0.08));
    S.Time:=0;
    S.Theme:=0;
    Stages.Add(S);
    for I:=0 to Audio.BossCount-1 do begin Check;
      if Bosses.Count>=64 then Break;
      Cue:=Audio.BossCue(I);
      A:=Result.HitBefore(Cue.StartTime+0.85)+1;
      B:=Result.HitBefore(Cue.KillTime);
      if (A<0) or (B>=Hits.Count) or (B-A<3) then Continue;
      if Hits[B].Time-Hits[A].Time<3 then Continue;
      Boss:=Default(TFightBoss);
      Boss.Start:=Max(0.0,Min(Cue.StartTime,Hits[A].Time-0.85));
      Boss.Ready:=Hits[A].Time;
      Boss.Kill:=Hits[B].Time;
      Boss.Finish:=Boss.Kill+0.80;
      if Bosses.Count>0 then if Boss.Start<Bosses[Bosses.Count-1].Finish+0.30 then Continue;
      Boss.FirstHit:=A;
      Boss.LastHit:=B;
      Boss.HP:=B-A+1;
      Boss.Side:=1;
      if Bosses.Count mod 2=1 then Boss.Side:=-1;
      for J:=0 to 2 do Boss.Purge[J]:=Hits[A+((B-A+1)*(J+1) div 4)].Time;
      Bosses.Add(Boss);
      if Cue.QuietBoundary then begin Boundary:=Boss.Kill;
        for J:=0 to 8 do if Audio.LevelAt(Boss.Kill+J*0.1)<0.22 then begin Boundary:=Boss.Kill+J*0.1;
          Break;
        end;
        if Boundary>Stages[Stages.Count-1].Time+8 then begin S.Time:=Boundary;
          S.Theme:=Stages.Count mod 4;
          Stages.Add(S);
        end;
      end;
    end;
    Result.FBosses:=Bosses.ToArray;
    I:=0;
    LastFocus:=-5;
    while I<Hits.Count do begin Check;
      J:=I;
      BI:=HitBoss(Hits[I].Time);
      while J<Hits.Count-1 do begin if (Hits[J+1].Time-Hits[I].Time>0.14+1E-9) or (Hits[J+1].Time-Hits[J].Time>0.105+1E-9) or (HitBoss(Hits[J+1].Time)<>BI) then Break;
        Inc(J);
      end;
      E:=Default(TFightEnemy);
      E.FirstHit:=I;
      E.LastHit:=J;
      E.Ready:=Hits[I].Time;
      E.Kill:=Hits[J].Time;
      E.Spawn:=Max(0.0,E.Ready-2.0);
      E.Boss:=BI;
      N:=Enemies.Count;
      Side:=1;
      if (N div 4) mod 2=1 then Side:=-1;
      if BI>=0 then Side:=Bosses[BI].Side;
      E.Side:=Side;
      Strength:=0;
      for K:=I to J do Strength:=Max(Strength,Hits[K].Strength);
      E.Kind:=N mod 3;
      if J>I then E.Kind:=N mod 2 else if Strength>=0.80 then E.Kind:=2;
      E.X:=BaseX(E.Ready)+Side*0.22;
      E.Y:=0.79;
      E.Speed:=0.72+0.10*(N mod 3);
      Enemies.Add(E);
      for K:=I to J do begin H:=Hits[K];
        H.Enemy:=N;
        H.Side:=Side;
        H.Kind:=E.Kind;
        H.Contact.X:=E.X-Side*0.036;
        if BI>=0 then H.Contact.X:=BaseX(H.Time)+Side*0.18;
        H.Contact.Y:=0.690;
        if H.Kind=1 then H.Contact.Y:=0.724;
        Hits[K]:=H;
      end;
      // Phrase-sized focus, never a random zoom on every dense accent.
      if (BI<0) and (E.Ready-LastFocus>=2.5) then begin
        A:=J;
        while A<Hits.Count-1 do begin if (Hits[A+1].Time-Hits[A].Time>0.35) or (Hits[A+1].Time-E.Ready>1.8) then Break;
          Inc(A);
        end;
        if (A-I>=2) or (Strength>=0.80) then begin F:=Default(TFightFocus);
          F.First:=Max(0.0,E.Ready-0.14);
          F.Last:=Min(Result.FEnd,Hits[A].Time+0.40);
          F.Peak:=E.Ready;
          F.Zoom:=1.15;
          F.Side:=Side;
          F.Kind:=0;
          if (A=J) and (Strength>=0.80) then begin F.Last:=Min(Result.FEnd,E.Ready+0.55);
            F.Zoom:=1.18;
            F.Kind:=1;
          end;
          Focus.Add(F);
          LastFocus:=F.Last;
        end;
      end;
      I:=J+1;
      if Enemies.Count>40000 then raise Exception.Create('Too many fighting groups');
    end;
    Result.FHits:=Hits.ToArray;
    Result.FEnemies:=Enemies.ToArray;
    Result.FFocus:=Focus.ToArray;
    Result.FStages:=Stages.ToArray;
    for I:=0 to Enemies.Count-1 do begin Check;
      E:=Enemies[I];
      if E.Ready<0.42 then Continue;
      V:=Default(TFightVolley);
      V.Near:=E.Ready-0.13;
      V.Launch:=Max(0.0,V.Near-0.55);
      V.Finish:=Min(Result.FEnd,V.Near+0.19);
      V.Side:=E.Side;
      V.Mode:=I mod 3;
      V.Enemy:=I;
      V.Origin:=Result.EnemyAt(I,V.Launch);
      V.Origin.Y:=0.68;
      if E.Boss>=0 then begin V.Origin:=Result.BossCenter(E.Boss,V.Launch);
        V.Origin.X:=V.Origin.X-E.Side*0.17;
        V.Origin.Y:=0.62;
      end;
      V.Target:=Point(BaseX(V.Near)+E.Side*0.025,0.690);
      if V.Mode=1 then V.Target.X:=BaseX(V.Near)+E.Side*0.080;
      if V.Mode=2 then begin V.Target.X:=BaseX(V.Near)+E.Side*0.040;
        V.Target.Y:=0.705;
      end;
      V.Count:=9;
      if E.Boss>=0 then begin V.Count:=13;
        for J:=0 to 2 do if V.Near>=Bosses[E.Boss].Purge[J] then Dec(V.Count,2);
      end;
      Volleys.Add(V);
    end;
    Result.FVolleys:=Volleys.ToArray;
    Result.Validate;
  except Result.Free;
    Result:=nil;
    Hits.Free;
    Enemies.Free;
    Bosses.Free;
    Volleys.Free;
    Focus.Free;
    Stages.Free;
    raise;
  end;
  Hits.Free;
  Enemies.Free;
  Bosses.Free;
  Volleys.Free;
  Focus.Free;
  Stages.Free;
end;

function TFightingPlan.HeroAt(Time:Double):TFightPose;
var
  I,J,N:Integer;
  H,Next:TFightHit;
  E:TFightEnemy;
  T,Near,Gap,U,A,Distance,Suppress,Side:Double;
  D:TDuelPose;
begin
  if FAction<>nil then begin D:=FAction.HeroAt(Time);
    Result:=Default(TFightPose);
    Result.X:=D.X;
    Result.Y:=D.Y;
    Result.Side:=D.Side;
    Result.Kind:=D.Kind;
    Result.Attack:=D.Attack;
    Result.Duck:=D.Duck;
    Result.Enemy:=-1;
    if D.Hit>=0 then begin Result.ContactX:=FAction.Hits[D.Hit].X;
      Result.ContactY:=FAction.Hits[D.Hit].Y;
      Result.Enemy:=FAction.Hits[D.Hit].Enemy;
    end;
    Exit;
  end;
  Time:=EnsureRange(Time,0.0,FEnd);
  Result:=Default(TFightPose);
  Result.X:=BaseX(Time);
  Result.Y:=0.79;
  Result.Side:=1;
  Result.Enemy:=-1;
  if (FEntry>0) and (Time<FEntry) then Result.X:=Result.X-1.10*(1-Smooth(Time/FEntry));
  if Time>FGoal then begin Result.X:=Result.X+1.7*Smooth((Time-FGoal)/0.90);
    Exit;
  end;
  I:=HitBefore(Time);
  J:=I+1;
  Distance:=100;
  if I>=0 then Distance:=Time-FHits[I].Time;
  if J<Count then Distance:=Min(Distance,FHits[J].Time-Time);
  Suppress:=EnsureRange(Distance/0.055,0.0,1.0);
  N:=EnemyBefore(Time)+1;
  if N<EnemyCount then begin E:=FEnemies[N];
    T:=E.Ready-0.34;
    if Time>=T then begin U:=EnsureRange((Time-T)/0.34,0.0,1.0);
      A:=Sin(Pi*U)*Suppress;
      Side:=E.Side;
      case N mod 3 of
        0:begin Result.X:=Result.X-Side*0.055*A;
          Result.Lean:=-Side*0.22*A;
          Result.Duck:=0.010*A;
        end;
        1:begin Result.Guard:=A;
          Result.Duck:=0.006*A;
        end;
        2:begin Near:=E.Ready-0.13;
          A:=Exp(-Sqr((Time-Near)/0.065))*Suppress;
          Result.Graze:=A;
          Result.X:=Result.X-Side*0.020*A;
          Result.Lean:=-Side*0.16*A;
        end;
      end;
    end;
  end;
  if Count=0 then Exit;
  if (I>=0) and (J<Count) and (FHits[I].Enemy=FHits[J].Enemy) then begin
    H:=FHits[I];
    Next:=FHits[J];
    Gap:=Next.Time-H.Time;
    if Gap>0 then U:=EnsureRange((Time-H.Time)/Gap,0.0,1.0) else U:=0;
    Result.Attack:=1-0.18*Sin(Pi*U);
    Result.ContactX:=H.Contact.X+(Next.Contact.X-H.Contact.X)*U;
    Result.ContactY:=H.Contact.Y;
    Result.Side:=H.Side;
    Result.Kind:=H.Kind;
    Result.Enemy:=H.Enemy;
    Exit;
  end;
  N:=I;
  if (N<0) or ((J<Count) and (FHits[J].Time-Time<Time-FHits[N].Time)) then N:=J;
  if (N<0) or (N>=Count) then Exit;
  H:=FHits[N];
  Gap:=0.10;
  if N>0 then Gap:=Min(Gap,(H.Time-FHits[N-1].Time)*0.45);
  A:=0.10;
  if N<Count-1 then A:=Min(A,(FHits[N+1].Time-H.Time)*0.45);
  if Abs(Time-H.Time)<1E-10 then Result.Attack:=1
  else if Time<=H.Time then Result.Attack:=Smooth((Time-(H.Time-Gap))/Max(1E-8,Gap)) else Result.Attack:=1-Smooth((Time-H.Time)/Max(1E-8,A));
  Result.ContactX:=H.Contact.X;
  Result.ContactY:=H.Contact.Y;
  Result.Side:=H.Side;
  Result.Kind:=H.Kind;
  Result.Enemy:=H.Enemy;
end;

function TFightingPlan.EnemyAt(Index:Integer;Time:Double):TFightPoint;
var
  E:TFightEnemy;
  Age,Power:Double;
  D:TDuelPose;
begin if FAction<>nil then begin D:=FAction.EnemyAt(Index,Time);
    Result:=Point(D.X,D.Y);
    Exit;
  end;
  E:=FEnemies[Index];
  Result:=Point(E.X,E.Y);
  if Time<E.Ready then Result.X:=Result.X+E.Side*E.Speed*(E.Ready-Time)/(1+0.75*(E.Ready-Time))
  else if Time>E.Kill then begin Age:=Time-E.Kill;
    Power:=FHits[E.LastHit].Strength;
    Result.X:=Result.X+E.Side*(0.9+Power*0.65)*Age;
    Result.Y:=Result.Y-(0.42+Power*0.15)*Age+0.95*Age*Age;
  end;
end;

function TFightingPlan.ShotAt(Index,Shot:Integer;Time:Double;out P:TFightPoint;out Alpha:Double):Boolean;
var
  V:TFightVolley;
  E:TFightEnemy;
  U,Age,Spread:Double;
  Target,Origin:TFightPoint;
begin V:=FVolleys[Index];
  P:=V.Origin;
  Alpha:=0;
  Result:=(Time>=V.Launch) and (Time<V.Finish);
  if not Result then Exit;
  Age:=Time-V.Launch;
  U:=Age/Max(1E-8,V.Near-V.Launch);
  Target:=V.Target;
  Spread:=(Shot-(V.Count-1)/2)*0.042;
  Target.Y:=Target.Y+Spread;
  if Shot<>(V.Count-1) div 2 then Target.X:=Target.X+V.Side*0.12;
  if Time<=V.Near then begin P.X:=V.Origin.X+(Target.X-V.Origin.X)*U;
    P.Y:=V.Origin.Y+(Target.Y-V.Origin.Y)*U;
    Alpha:=1;
  end
  else begin U:=(Time-V.Near)/(V.Finish-V.Near);
    P:=Target;
    if (Shot=(V.Count-1) div 2) and (V.Mode=1) then begin P.X:=P.X+V.Side*U*0.22;
      P.Y:=P.Y-U*0.15;
    end
    else if Shot=(V.Count-1) div 2 then begin E:=FEnemies[V.Enemy];
      Origin:=EnemyAt(V.Enemy,Time);
      Origin.Y:=0.68;
      if E.Boss>=0 then begin Origin:=BossCenter(E.Boss,Time);
        Origin.X:=Origin.X-E.Side*0.17;
        Origin.Y:=0.62;
      end;
      P.X:=Target.X+(Origin.X-Target.X)*U;
      P.Y:=Target.Y+(Origin.Y-Target.Y)*U;
    end
    else begin P.X:=P.X+(Target.X-V.Origin.X)*U*0.08;
      P.Y:=P.Y+(Target.Y-V.Origin.Y)*U*0.08;
    end;
    Alpha:=1-U;
  end;
end;

procedure TFightingPlan.CameraAt(Time:Double;out CenterX,CenterY,Zoom:Double);
var
  I,B,A,M:Integer;
  F:TFightFocus;
  U,W:Double;
begin if FAction<>nil then begin FAction.CameraAt(Time,CenterX,CenterY,Zoom);
    Exit;
  end;
  CenterX:=BaseX(Min(Time,FGoal));
  CenterY:=0.66;
  Zoom:=1;
  B:=BossAt(Time);
  if B>=0 then begin U:=Smooth((Time-FBosses[B].Start)/1.1)*(1-Smooth((Time-FBosses[B].Kill)/0.65));
    Zoom:=1+0.055*U;
    CenterX:=CenterX+FBosses[B].Side*0.055*U;
    Exit;
  end;
  A:=0;
  B:=Length(FFocus);
  while A<B do begin M:=(A+B) div 2;
    if FFocus[M].First<=Time then A:=M+1 else B:=M;
  end;
  I:=A-1;
  if I>=0 then begin F:=FFocus[I];
    if Time>F.Last then Exit;
    W:=Smooth((Time-F.First)/0.16)*(1-Smooth((Time-(F.Last-0.30))/0.30));
    if F.Kind=1 then W:=W*(1-Smooth((Time-F.Peak-0.08)/0.28));
    Zoom:=1+(F.Zoom-1)*W;
    CenterX:=CenterX+F.Side*0.045*W;
  end;
end;

function TFightingPlan.ThemeAt(Time:Double):Integer;
var
  I:Integer;
begin if FAction<>nil then Exit(FAction.ThemeAt(Time));
  Result:=0;
  for I:=0 to StageCount-1 do begin if FStages[I].Time>Time then Break;
    Result:=FStages[I].Theme;
  end;
end;

procedure TFightingPlan.Validate;
var
  I,J,N:Integer;
  H:TFightHit;
  E:TFightEnemy;
  P:TFightPose;
  B:TFightBoss;
  V:TFightVolley;
  F:TFightFocus;
  D,R:Double;
  procedure Need(V:Boolean;const Why:string);
  begin if not V then raise Exception.Create('Fighting plan: '+Why);
  end;
begin
  Need(Finite(FDuration) and Finite(FGoal) and Finite(FEnd) and (FDuration>0) and (FGoal>=0) and (FGoal<=FDuration) and (FEnd<=FGoal+0.901),'bounds');
  Need((PulseCount<=100000) and (EnemyCount<=40000) and (BossCount<=64) and (VolleyCount<=40000) and (StageCount<=65),'limits');
  Need((FFrequency>=0) and (FFrequency<=100) and (FExcluded>=0) and (Count+FExcluded=PulseCount),'source count');
  if FFrequency=0 then Need(BossCount=0,'boss disabled');
  Need(Finite(FEntry) and (FEntry>=0) and (FEntry<=0.65) and (FEnd>=FGoal),'entry/end');
  for I:=0 to PulseCount-1 do begin Need(Finite(FEvents[I].Time) and Finite(FEvents[I].Strength) and (FEvents[I].Time>=0) and (FEvents[I].Time<=FDuration+0.011),'source event');
    if I>0 then Need(FEvents[I].Time>=FEvents[I-1].Time,'source order');
  end;
  for I:=0 to Count-1 do begin H:=FHits[I];
    Need(Finite(H.Time) and Finite(H.Strength) and (H.Time>=0) and (H.Time<=FGoal+1E-6) and (H.Strength>=0) and (H.Strength<=1),'hit data');
    Need((H.Source>=0) and (H.Source<PulseCount) and (H.Time=FEvents[H.Source].Time),'hit clock');
    Need((H.Enemy>=0) and (H.Enemy<EnemyCount) and ((H.Side=-1) or (H.Side=1)) and (H.Kind in [0,1,2]),'hit links');
    if I>0 then Need(H.Time>=FHits[I-1].Time,'hit order');
    E:=FEnemies[H.Enemy];
    Need((I>=E.FirstHit) and (I<=E.LastHit),'group link');
    P:=HeroAt(H.Time);
    Need(Abs(P.Attack-1)<1E-7,'attack not at impact');
    Need((Abs(P.ContactX-H.Contact.X)<1E-7) and (Abs(P.ContactY-H.Contact.Y)<1E-7),'pose contact');
    R:=0.014;
    if H.Kind=1 then R:=0.017;
    D:=Abs(H.Contact.X-H.Side*R-(P.X+H.Side*0.022));
    Need(D<0.178,'limb reach');
    if E.Boss<0 then Need(Abs(H.Contact.X-(E.X-H.Side*0.036))<1E-7,'enemy surface')
    else Need(Abs(H.Contact.X-(HeroBase(H.Time)+H.Side*0.18))<1E-7,'boss surface');
  end;
  N:=0;
  for I:=0 to EnemyCount-1 do begin E:=FEnemies[I];
    Need((E.FirstHit=N) and (E.LastHit>=E.FirstHit) and (E.LastHit<Count),'group coverage');
    N:=E.LastHit+1;
    Need((E.Ready=FHits[E.FirstHit].Time) and (E.Kill=FHits[E.LastHit].Time) and (E.Kill-E.Ready<=0.14+1E-8),'group clocks');
    Need((E.Spawn>=0) and (E.Spawn<=E.Ready) and (E.Boss>=-1) and (E.Boss<BossCount) and Finite(E.X) and Finite(E.Y),'enemy data');
  end;
  Need(N=Count,'coverage');
  for I:=0 to BossCount-1 do begin B:=FBosses[I];
    Need((B.FirstHit>=0) and (B.LastHit<Count) and (B.LastHit>B.FirstHit) and (B.HP=B.LastHit-B.FirstHit+1),'boss source');
    Need((B.Start<=B.Ready) and (B.Ready=FHits[B.FirstHit].Time) and (B.Kill=FHits[B.LastHit].Time) and (Abs(B.Finish-(B.Kill+0.80))<1E-7),'boss clock');
    Need((B.Side=-1) or (B.Side=1),'boss side');
    for J:=0 to 2 do Need(Abs(B.Purge[J]-FHits[B.FirstHit+(B.HP*(J+1) div 4)].Time)<1E-7,'part source clock');
    if I>0 then Need(B.Start>=FBosses[I-1].Finish+0.30-1E-7,'boss spacing');
  end;
  for I:=0 to VolleyCount-1 do begin V:=FVolleys[I];
    Need((V.Launch>=0) and (V.Near>V.Launch) and (V.Finish>V.Near) and (V.Finish<=FEnd) and (V.Count in [7,9,11,13]),'volley');
    Need((V.Enemy>=0) and (V.Enemy<EnemyCount) and (V.Mode in [0,1,2]) and ((V.Side=-1) or (V.Side=1)) and Finite(V.Origin.X) and Finite(V.Origin.Y) and Finite(V.Target.X) and Finite(V.Target.Y),'volley data');
    if I>0 then Need(V.Launch>=FVolleys[I-1].Launch,'volley order');
  end;
  for I:=0 to High(FFocus) do begin F:=FFocus[I];
    Need((F.First>=0) and (F.Last>F.First) and (F.Peak>=F.First) and (F.Peak<=F.Last) and (F.Zoom>=1) and (F.Zoom<=1.18) and (F.Kind in [0,1]) and ((F.Side=-1) or (F.Side=1)),'focus');
    if I>0 then Need(F.First>FFocus[I-1].Last,'focus order');
  end;
  Need((StageCount>0) and (FStages[0].Time=0),'first stage');
  for I:=0 to StageCount-1 do begin Need((FStages[I].Time>=0) and (FStages[I].Time<=FEnd) and (FStages[I].Theme in [0,1,2,3]),'stage');
    if I>0 then Need(FStages[I].Time>FStages[I-1].Time,'stage order');
  end;
end;

procedure TFightingPlan.Save(var Ref:TRhythmPlanRef;Audio:TRhythmAudio);
var
  Root,J:TJSONObject;
  A:TJSONArray;
  H:TRhythmHit;
  Hit:TFightHit;
  E:TFightEnemy;
  B:TFightBoss;
  V:TFightVolley;
  F:TFightFocus;
  S:TFightStage;
begin
  if FAction<>nil then begin
    if (Ref.Version<>2) or not Ref.Matches(Audio.Key,Audio.Sensitivity,Ref.Direction,rsFighting,Ref.Variant) or (BossFrequencyFromVariant(Ref.Variant)<>FAction.Frequency) then raise Exception.Create('Fighting v2 save identity');
    Root:=TJSONObject.Create;
    try Root.AddPair('schema',TJSONNumber.Create(1));
      Root.AddPair('style','fighting');
      Root.AddPair('version',TJSONNumber.Create(2));
      Root.AddPair('key',Ref.Key);
      Root.AddPair('source',Ref.SourceKey);
      Root.AddPair('sensitivity',TJSONNumber.Create(Ref.Sensitivity));
      Root.AddPair('direction',TJSONNumber.Create(Ref.Direction));
      AddPreparedAudio(Root,Audio);
      Root.AddPair('duel',FAction.ToJSON);
      WritePreparedData(Root,Ref);
    finally Root.Free;
    end;
    Exit;
  end;
  if (Ref.Version<>1) or not Ref.Matches(Audio.Key,Audio.Sensitivity,Ref.Direction,rsFighting,Ref.Variant) or (BossFrequencyFromVariant(Ref.Variant)<>FFrequency) then raise Exception.Create('Fighting save identity');
  Validate;
  Root:=TJSONObject.Create;
  try Root.AddPair('schema',TJSONNumber.Create(1));
    Root.AddPair('style','fighting');
    Root.AddPair('version',TJSONNumber.Create(1));
    Root.AddPair('key',Ref.Key);
    Root.AddPair('source',Ref.SourceKey);
    Root.AddPair('sensitivity',TJSONNumber.Create(Ref.Sensitivity));
    Root.AddPair('direction',TJSONNumber.Create(Ref.Direction));
    AddPreparedAudio(Root,Audio);
    Root.AddPair('policy','contact-crowd-v1');
    Root.AddPair('goal',TJSONNumber.Create(FGoal));
    Root.AddPair('end',TJSONNumber.Create(FEnd));
    Root.AddPair('entry',TJSONNumber.Create(FEntry));
    Root.AddPair('frequency',TJSONNumber.Create(FFrequency));
    Root.AddPair('excluded',TJSONNumber.Create(FExcluded));
    A:=TJSONArray.Create;
    Root.AddPair('events',A);
    for H in FEvents do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('t',TJSONNumber.Create(H.Time));
      J.AddPair('s',TJSONNumber.Create(H.Strength));
    end;
    A:=TJSONArray.Create;
    Root.AddPair('hits',A);
    for Hit in FHits do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('t',TJSONNumber.Create(Hit.Time));
      J.AddPair('s',TJSONNumber.Create(Hit.Strength));
      J.AddPair('src',TJSONNumber.Create(Hit.Source));
      J.AddPair('e',TJSONNumber.Create(Hit.Enemy));
      J.AddPair('k',TJSONNumber.Create(Hit.Kind));
      J.AddPair('side',TJSONNumber.Create(Hit.Side));
      J.AddPair('x',TJSONNumber.Create(Hit.Contact.X));
      J.AddPair('y',TJSONNumber.Create(Hit.Contact.Y));
    end;
    A:=TJSONArray.Create;
    Root.AddPair('enemies',A);
    for E in FEnemies do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('first',TJSONNumber.Create(E.FirstHit));
      J.AddPair('last',TJSONNumber.Create(E.LastHit));
      J.AddPair('side',TJSONNumber.Create(E.Side));
      J.AddPair('kind',TJSONNumber.Create(E.Kind));
      J.AddPair('boss',TJSONNumber.Create(E.Boss));
      J.AddPair('spawn',TJSONNumber.Create(E.Spawn));
      J.AddPair('ready',TJSONNumber.Create(E.Ready));
      J.AddPair('kill',TJSONNumber.Create(E.Kill));
      J.AddPair('x',TJSONNumber.Create(E.X));
      J.AddPair('y',TJSONNumber.Create(E.Y));
      J.AddPair('speed',TJSONNumber.Create(E.Speed));
    end;
    A:=TJSONArray.Create;
    Root.AddPair('bosses',A);
    for B in FBosses do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('start',TJSONNumber.Create(B.Start));
      J.AddPair('ready',TJSONNumber.Create(B.Ready));
      J.AddPair('kill',TJSONNumber.Create(B.Kill));
      J.AddPair('finish',TJSONNumber.Create(B.Finish));
      J.AddPair('side',TJSONNumber.Create(B.Side));
      J.AddPair('first',TJSONNumber.Create(B.FirstHit));
      J.AddPair('last',TJSONNumber.Create(B.LastHit));
      J.AddPair('hp',TJSONNumber.Create(B.HP));
      J.AddPair('p0',TJSONNumber.Create(B.Purge[0]));
      J.AddPair('p1',TJSONNumber.Create(B.Purge[1]));
      J.AddPair('p2',TJSONNumber.Create(B.Purge[2]));
    end;
    A:=TJSONArray.Create;
    Root.AddPair('volleys',A);
    for V in FVolleys do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('launch',TJSONNumber.Create(V.Launch));
      J.AddPair('near',TJSONNumber.Create(V.Near));
      J.AddPair('finish',TJSONNumber.Create(V.Finish));
      J.AddPair('ox',TJSONNumber.Create(V.Origin.X));
      J.AddPair('oy',TJSONNumber.Create(V.Origin.Y));
      J.AddPair('tx',TJSONNumber.Create(V.Target.X));
      J.AddPair('ty',TJSONNumber.Create(V.Target.Y));
      J.AddPair('count',TJSONNumber.Create(V.Count));
      J.AddPair('mode',TJSONNumber.Create(V.Mode));
      J.AddPair('side',TJSONNumber.Create(V.Side));
      J.AddPair('enemy',TJSONNumber.Create(V.Enemy));
    end;
    A:=TJSONArray.Create;
    Root.AddPair('focus',A);
    for F in FFocus do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('first',TJSONNumber.Create(F.First));
      J.AddPair('last',TJSONNumber.Create(F.Last));
      J.AddPair('peak',TJSONNumber.Create(F.Peak));
      J.AddPair('zoom',TJSONNumber.Create(F.Zoom));
      J.AddPair('side',TJSONNumber.Create(F.Side));
      J.AddPair('kind',TJSONNumber.Create(F.Kind));
    end;
    A:=TJSONArray.Create;
    Root.AddPair('stages',A);
    for S in FStages do begin J:=TJSONObject.Create;
      A.AddElement(J);
      J.AddPair('t',TJSONNumber.Create(S.Time));
      J.AddPair('theme',TJSONNumber.Create(S.Theme));
    end;
    WritePreparedData(Root,Ref);
  finally Root.Free;
  end;
end;

class function TFightingPlan.LoadAudioMetadata(const Ref:TRhythmPlanRef;const Source:string;Direction:Integer):TRhythmAudio;
var
  Root,J:TJSONObject;
  A:TJSONArray;
  I:Integer;
  Duel:TFightingDuel;
begin Root:=ReadPreparedData(Ref,rsFighting,Direction);
  Result:=nil;
  try Result:=PreparedAudio(Root,Ref,Source);
    try if Ref.Version=2 then begin Duel:=TFightingDuel.FromJSON(Root.GetValue<TJSONObject>('duel'),Result);
        try for I:=0 to High(Duel.Events) do Result.Hits[I]:=Duel.Events[I];
          Result.SetBossFrequency(Duel.Frequency);
        finally Duel.Free;
        end;
        Exit;
      end;
      A:=Root.GetValue<TJSONArray>('events');
      if (A=nil) or (A.Count<>Length(Result.Hits)) then raise Exception.Create('Fighting event metadata');
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        Result.Hits[I].Time:=J.GetValue<Double>('t');
        Result.Hits[I].Strength:=J.GetValue<Double>('s');
      end;
      Result.SetBossFrequency(BossFrequencyFromVariant(Ref.Variant));
    except Result.Free;
      Result:=nil;
      raise;
    end;
  finally Root.Free;
  end;
end;

class function TFightingPlan.Load(const Ref:TRhythmPlanRef;Audio:TRhythmAudio;Direction:Integer):TFightingPlan;
var
  Root,J,Info:TJSONObject;
  A:TJSONArray;
  I:Integer;
  H:TRhythmHit;
  Hit:TFightHit;
  E:TFightEnemy;
  B:TFightBoss;
  V:TFightVolley;
  F:TFightFocus;
  S:TFightStage;
  function Items(const Name:string;Limit:Integer):TJSONArray;
  begin Result:=Root.GetValue<TJSONArray>(Name);
    if (Result=nil) or (Result.Count>Limit) then raise Exception.Create('Fighting '+Name+' count');
  end;
begin
  Result:=nil;
  if Audio=nil then raise EArgumentNilException.Create('Audio');
  if not Ref.Matches(Audio.Key,Audio.Sensitivity,Direction,rsFighting,Ref.Variant) then raise Exception.Create('Fighting load identity');
  Root:=ReadPreparedData(Ref,rsFighting,Direction);
  try if Ref.Version=2 then begin
      Result:=TFightingPlan.Create;
      try Result.FRecipeVersion:=2;
        Result.FAction:=TFightingDuel.FromJSON(Root.GetValue<TJSONObject>('duel'),Audio);
        if Result.FAction.Frequency<>BossFrequencyFromVariant(Ref.Variant) then raise Exception.Create('Fighting v2 frequency');
        Result.FGoal:=Result.FAction.Goal;
        Result.FEnd:=Result.FAction.EndTime;
        Result.FDuration:=Result.FAction.Duration;
        Result.FFrequency:=Result.FAction.Frequency;
      except Result.Free;
        Result:=nil;
        raise;
      end;
      Exit;
    end;
    if Root.GetValue<string>('policy','')<>'contact-crowd-v1' then raise Exception.Create('Fighting policy');
    Info:=Root.GetValue<TJSONObject>('audio');
    if (Info=nil) or (Info.GetValue<Integer>('events')<>Length(Audio.Hits)) or (Abs(Info.GetValue<Double>('duration')-Audio.Duration)>1E-6) or (Abs(Info.GetValue<Double>('soundEnd')-Audio.SoundEnd)>1E-6) then raise Exception.Create('Fighting metadata identity');
    Result:=TFightingPlan.Create;
    Result.FRecipeVersion:=1;
    try Result.FDuration:=Audio.Duration;
      Result.FGoal:=Root.GetValue<Double>('goal');
      Result.FEnd:=Root.GetValue<Double>('end');
      Result.FEntry:=Root.GetValue<Double>('entry');
      Result.FFrequency:=Root.GetValue<Integer>('frequency');
      Result.FExcluded:=Root.GetValue<Integer>('excluded');
      if Result.FFrequency<>BossFrequencyFromVariant(Ref.Variant) then raise Exception.Create('Fighting frequency');
      A:=Items('events',100000);
      SetLength(Result.FEvents,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        H:=Default(TRhythmHit);
        H.Time:=J.GetValue<Double>('t');
        H.Strength:=J.GetValue<Double>('s');
        Result.FEvents[I]:=H;
      end;
      A:=Items('hits',100000);
      SetLength(Result.FHits,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        Hit.Time:=J.GetValue<Double>('t');
        Hit.Strength:=J.GetValue<Double>('s');
        Hit.Source:=J.GetValue<Integer>('src');
        Hit.Enemy:=J.GetValue<Integer>('e');
        Hit.Kind:=J.GetValue<Integer>('k');
        Hit.Side:=J.GetValue<Integer>('side');
        Hit.Contact:=Point(J.GetValue<Double>('x'),J.GetValue<Double>('y'));
        Result.FHits[I]:=Hit;
      end;
      A:=Items('enemies',40000);
      SetLength(Result.FEnemies,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        E.FirstHit:=J.GetValue<Integer>('first');
        E.LastHit:=J.GetValue<Integer>('last');
        E.Side:=J.GetValue<Integer>('side');
        E.Kind:=J.GetValue<Integer>('kind');
        E.Boss:=J.GetValue<Integer>('boss');
        E.Spawn:=J.GetValue<Double>('spawn');
        E.Ready:=J.GetValue<Double>('ready');
        E.Kill:=J.GetValue<Double>('kill');
        E.X:=J.GetValue<Double>('x');
        E.Y:=J.GetValue<Double>('y');
        E.Speed:=J.GetValue<Double>('speed');
        Result.FEnemies[I]:=E;
      end;
      A:=Items('bosses',64);
      SetLength(Result.FBosses,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        B.Start:=J.GetValue<Double>('start');
        B.Ready:=J.GetValue<Double>('ready');
        B.Kill:=J.GetValue<Double>('kill');
        B.Finish:=J.GetValue<Double>('finish');
        B.Side:=J.GetValue<Integer>('side');
        B.FirstHit:=J.GetValue<Integer>('first');
        B.LastHit:=J.GetValue<Integer>('last');
        B.HP:=J.GetValue<Integer>('hp');
        B.Purge[0]:=J.GetValue<Double>('p0');
        B.Purge[1]:=J.GetValue<Double>('p1');
        B.Purge[2]:=J.GetValue<Double>('p2');
        Result.FBosses[I]:=B;
      end;
      A:=Items('volleys',40000);
      SetLength(Result.FVolleys,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        V.Launch:=J.GetValue<Double>('launch');
        V.Near:=J.GetValue<Double>('near');
        V.Finish:=J.GetValue<Double>('finish');
        V.Origin:=Point(J.GetValue<Double>('ox'),J.GetValue<Double>('oy'));
        V.Target:=Point(J.GetValue<Double>('tx'),J.GetValue<Double>('ty'));
        V.Count:=J.GetValue<Integer>('count');
        V.Mode:=J.GetValue<Integer>('mode');
        V.Side:=J.GetValue<Integer>('side');
        V.Enemy:=J.GetValue<Integer>('enemy');
        Result.FVolleys[I]:=V;
      end;
      A:=Items('focus',10000);
      SetLength(Result.FFocus,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        F.First:=J.GetValue<Double>('first');
        F.Last:=J.GetValue<Double>('last');
        F.Peak:=J.GetValue<Double>('peak');
        F.Zoom:=J.GetValue<Double>('zoom');
        F.Side:=J.GetValue<Double>('side');
        F.Kind:=J.GetValue<Integer>('kind');
        Result.FFocus[I]:=F;
      end;
      A:=Items('stages',65);
      SetLength(Result.FStages,A.Count);
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;
        S.Time:=J.GetValue<Double>('t');
        S.Theme:=J.GetValue<Integer>('theme');
        Result.FStages[I]:=S;
      end;
      Result.Validate;
    except Result.Free;
      Result:=nil;
      raise;
    end;
  finally Root.Free;
  end;
end;
