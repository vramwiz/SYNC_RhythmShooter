unit RhythmBallCircuitScene;
// 事前計画を絶対時刻で描画する。任意シークで状態を進めたり音時刻を変えたりしない。
interface
uses RhythmBallCircuitPlan,RhythmRenderSurface,RhythmAnimation;
procedure DrawBallCircuit(Plan:TBallCircuitPlan;Surface:TAnimationRenderSurface;const Frame:TAnimationFrame);
implementation
uses System.Math,Winapi.Windows,Vcl.Graphics,RhythmBallGeometry;

procedure DrawBallCircuit(Plan:TBallCircuitPlan;Surface:TAnimationRenderSurface;const Frame:TAnimationFrame);
var
  W,H,SX,SY,Scale,Clock,Age,U,Fade,Angle,Charge:Double;
  I,J,A,B,Current,FromRoute,ToRoute:Integer;
  P,Q,R,Normal,Tangent,Center,Joint:TBallPoint;
  Route:TCircuitSegment;
  Node:TCircuitNode;
  Obj:TCircuitObject;
  function Color(C:TColor;Amount:Double=1):TColor;
  begin Amount:=EnsureRange(Amount,0.0,1.0);
    Result:=RGB(Round(7+(GetRValue(C)-7)*Amount),Round(13+(GetGValue(C)-13)*Amount),Round(29+(GetBValue(C)-29)*Amount));
  end;
  procedure Map(const V:TBallPoint;out X,Y:Double);
  begin if Frame.Direction=0 then begin X:=V.X*SX;
      Y:=V.Y*SY;
    end else begin X:=(1-V.Y)*SX;
      Y:=V.X*SY;
    end;
  end;
  procedure Line(const A,B:TBallPoint;C:TColor;Width:Double);
  var
    X1,Y1,X2,Y2:Double;
  begin Map(A,X1,Y1);
    Map(B,X2,Y2);
    Surface.Line(X1,Y1,X2,Y2,C,Max(1,Width*Scale));
  end;
  procedure Circle(const V:TBallPoint;Radius:Double;C:TColor;Filled:Boolean=True;Stroke:Double=0.002);
  var
    X,Y,RX,RY,DX,YY,Step:Double;
    I:Integer;
    A,B:TBallPoint;
  begin
    if Radius<=0 then Exit;
    Map(V,X,Y);
    RX:=Radius*SX;
    RY:=Radius*SY;
    if Abs(SX-SY)<0.01 then begin Surface.Circle(X,Y,Radius*Scale,C,Filled,Max(1,Stroke*Scale));
      Exit;
    end;
    if Filled then begin Step:=Max(1,2*RY/32);
      YY:=-RY;
      while YY<RY do begin DX:=RX*Sqrt(Max(0.0,1-Sqr((YY+Step/2)/RY)));
        Surface.FillRect(X-DX,Y+YY,X+DX+1,Y+Min(RY,YY+Step)+1,C);
        YY:=YY+Step;
      end;
    end
    else begin A:=BallAdd(V,BallPoint(Radius,0));
      for I:=1 to 40 do begin B:=BallAdd(V,BallPoint(Cos(I*Pi/20)*Radius,Sin(I*Pi/20)*Radius));
        Line(A,B,C,Stroke);
        A:=B;
      end;
    end;
  end;
  procedure Rail(const R:TCircuitSegment;Amount:Double);
  var
    I:Integer;
    P,Q,D,N,A,B,LastA,LastB:TBallPoint;
    TT:Double;
  begin
    if R.Kind=cmLoop then begin Circle(R.Center,R.Radius-CIRCUIT_RADIUS-0.003,Color(RGB(80,178,211),Amount),False,0.006);
      Circle(R.Center,R.Radius+CIRCUIT_RADIUS+0.003,Color(RGB(119,222,230),Amount),False,0.006);
      Exit;
    end;
    for I:=0 to 40 do begin TT:=R.First+(R.Last-R.First)*I/40;
      P:=CircuitPoint(R,TT);
      Q:=CircuitPoint(R,Min(R.Last,TT+0.0001));
      if I=40 then begin Q:=P;
        P:=CircuitPoint(R,Max(R.First,TT-0.0001));
      end;
      D:=BallUnit(BallSub(Q,P));
      N:=BallPoint(-D.Y,D.X);
      P:=CircuitPoint(R,TT);
      A:=BallAdd(P,BallScale(N,CIRCUIT_RADIUS+0.003));
      B:=BallSub(P,BallScale(N,CIRCUIT_RADIUS+0.003));
      if I>0 then begin Line(LastA,A,Color(RGB(80,178,211),Amount),0.006);
        Line(LastB,B,Color(RGB(119,222,230),Amount),0.006);
      end;
      LastA:=A;
      LastB:=B;
    end;
  end;
begin
  W:=Frame.Width;
  H:=Frame.Height;
  if Frame.Direction=0 then begin SX:=W/CIRCUIT_WIDTH;
    SY:=H;
  end else begin SX:=W;
    SY:=H/CIRCUIT_WIDTH;
  end;
  Scale:=Min(SX,SY);
  Clock:=0;
  if Plan<>nil then Clock:=EnsureRange(Frame.Time,0.0,Plan.EndTime);
  for I:=0 to 31 do Surface.FillRect(0,H*I/32,W,H*(I+1)/32+1,RGB(7+I div 6,14+I div 3,30+I div 2));
  // The field uses both full screen axes; there is no narrow portrait table.
  for I:=1 to 15 do begin U:=I/16;
    Surface.Line(U*W,0,U*W,H,RGB(17,35,54),1);
  end;
  for I:=1 to 8 do begin U:=I/9;
    Surface.Line(0,U*H,W,U*H,RGB(17,35,54),1);
  end;
  Line(BallPoint(0.003,0.003),BallPoint(CIRCUIT_WIDTH-0.003,0.003),RGB(69,127,164),0.004);
  Line(BallPoint(0.003,0.997),BallPoint(CIRCUIT_WIDTH-0.003,0.997),RGB(69,127,164),0.004);
  Line(BallPoint(0.003,0.003),BallPoint(0.003,0.997),RGB(69,127,164),0.004);
  Line(BallPoint(CIRCUIT_WIDTH-0.003,0.003),BallPoint(CIRCUIT_WIDTH-0.003,0.997),RGB(69,127,164),0.004);
  if (Plan=nil) or (Plan.EndTime<=0) then Exit;
  Current:=Plan.SegmentAt(Clock);
  FromRoute:=Max(0,Current-2);
  ToRoute:=Min(Plan.SegmentCount-1,Current+4);
  for I:=FromRoute to ToRoute do begin Route:=Plan.Segment[I];
    if (Clock<Route.First-2.4) or (Clock>Route.Last+0.7) then Continue;
    if (Route.Kind=cmArm) and ((Clock<Route.First-0.15) or (Clock>Route.Last+0.25)) then Continue;
    U:=0.38;
    if (Clock>=Route.First) and (Clock<=Route.Last) then U:=0.95;
    if Route.Kind in [cmRail,cmLoop] then Rail(Route,U);
    if Route.Kind=cmArm then begin
      P:=CircuitPoint(Route,EnsureRange(Clock,Route.First,Route.Last));
      Normal:=BallUnit(BallSub(P,Route.Center));
      Joint:=BallSub(P,BallScale(Normal,CIRCUIT_RADIUS+0.007));
      Line(Route.Center,Joint,Color(RGB(61,117,169),U),0.025);
      Line(Route.Center,Joint,Color(RGB(143,217,236),U),0.009);
      Circle(Route.Center,0.032,Color(RGB(31,66,99),U));
      Circle(Route.Center,0.019,Color(RGB(146,210,224),U),False,0.005);
      Circle(Joint,0.007,Color(RGB(231,216,144),U));
      R:=BallSub(Route.Center,BallScale(Normal,0.045));
      Circle(R,0.022,Color(RGB(77,126,171),U));
    end;
    if Route.Kind=cmHold then begin
      P:=Route.A;
      Charge:=EnsureRange((Clock-Route.First)/Max(1E-6,Route.Last-Route.First),0.0,1.0);
      Circle(P,CIRCUIT_RADIUS+0.006,Color(RGB(124,164,178),U),False,0.012);
      for J:=0 to 5 do begin Angle:=J*Pi/3;
        R:=BallAdd(P,BallPoint(Cos(Angle)*0.045,Sin(Angle)*0.045));
        Circle(R,0.005,Color(RGB(255,194,84),U*(0.3+0.7*Ord(J/6<Charge))));
      end;
      Q:=BallAdd(P,BallPoint(0,0.066));
      Line(BallAdd(Q,BallPoint(-0.052,0)),BallAdd(Q,BallPoint(0.052,0)),Color(RGB(54,87,112),U),0.022);
    end;
  end;
  // Large reflectors are real collision surfaces, not rings attached to the ball.
  A:=Max(1,Plan.NodeBefore(Clock-0.32));
  B:=Min(Plan.NodeCount-1,Plan.NodeBefore(Clock+0.45)+1);
  for I:=A to B do begin Node:=Plan.Node[I];
    Age:=Clock-Node.Time;
    if (Age< -0.22) or (Age>0.30) or (Node.Kind<>cnBumper) then Continue;
    Center:=BallSub(Node.P,BallScale(Node.Normal,Node.Radius+CIRCUIT_RADIUS));
    U:=1;
    if Age>=0 then U:=1-Age/0.30;
    Circle(Center,Node.Radius,Color(RGB(37,92,127),U));
    Circle(Center,Node.Radius,Color(RGB(102,222,241),U),False,0.006);
    P:=Center;
    if (Age>=0) and (Age<0.18) then P:=BallSub(P,BallScale(Node.Normal,0.014*Sin(Pi*Age/0.18)));
    Circle(P,Node.Radius*0.60,Color(RGB(16,45,75),U));
    Circle(P,Node.Radius*0.37,Color(RGB(193,237,232),U));
  end;
  A:=Max(0,Plan.ObjectBefore(Clock-0.42)+1);
  B:=Min(Plan.ObjectBefore(Clock+0.21),Plan.ObjectBefore(Clock)+64);
  A:=Max(A,Plan.ObjectBefore(Clock)-63);
  for I:=A to B do begin Obj:=Plan.Obj[I];
    if Clock<Obj.Show then Continue;
    Age:=Clock-Obj.Time;
    Normal:=Obj.Normal;
    Tangent:=BallPoint(-Normal.Y,Normal.X);
    if (Obj.Kind=coWall) and (Age<0) then begin Center:=BallSub(Obj.Point,BallScale(Normal,Obj.Half));
      Line(BallSub(Center,BallScale(Tangent,0.065)),BallAdd(Center,BallScale(Tangent,0.065)),RGB(175,104,85),Max(0.001,Obj.Half*2));
      Line(BallSub(Obj.Point,BallScale(Tangent,0.050)),BallAdd(Obj.Point,BallScale(Tangent,0.050)),RGB(255,187,110),0.002);
    end;
    if (Age>=0) and (Age<0.24) then begin U:=1-Age/0.24;
      if Obj.Kind=coWall then for J:=0 to 3 do begin P:=BallAdd(Obj.Point,BallAdd(BallScale(Normal,-Age*(0.38+0.08*(J mod 2))),BallScale(Tangent,(J-1.5)*(0.025+Age*0.15))));
        Q:=BallAdd(P,BallScale(Tangent,0.014*U));
        Line(P,Q,Color(RGB(239,170,99),U),0.007*U);
      end;
      if Age<0.060 then begin R:=BallAdd(Obj.Point,BallScale(Tangent,0.016*U));
        Q:=BallSub(Obj.Point,BallScale(Tangent,0.016*U));
        Line(Q,R,Color(RGB(255,238,173),U),0.003*U);
      end;
    end;
  end;
  if Frame.Time>=Plan.EndTime then Exit;
  Fade:=EnsureRange((Plan.EndTime-Clock)/0.18,0.0,1.0);
  for I:=8 downto 1 do begin P:=Plan.PositionAt(Max(0.0,Clock-I*0.012));
    Q:=Plan.PositionAt(Max(0.0,Clock-(I-1)*0.012));
    Line(P,Q,Color(RGB(98,191,235),(1-I/10)*0.60*Fade),CIRCUIT_RADIUS*(1-I/10));
  end;
  P:=Plan.PositionAt(Clock);
  Circle(P,CIRCUIT_RADIUS*1.18,Color(RGB(61,132,179),Fade));
  Circle(P,CIRCUIT_RADIUS,Color(RGB(242,224,151),Fade));
  Circle(BallAdd(P,BallPoint(-0.005,-0.006)),CIRCUIT_RADIUS*0.53,Color(RGB(255,253,224),Fade));
end;
end.
