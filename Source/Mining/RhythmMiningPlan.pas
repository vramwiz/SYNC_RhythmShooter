unit RhythmMiningPlan;
// Prepared excavation score. Audio clocks are immutable; Draw only evaluates it.
interface
uses System.SysUtils,RhythmAudio,RhythmPlanRef;
const MINING_WIDTH=1.6;MINING_TIP=0.152;MINING_HALF=0.135;
type
  TMiningPoint=record X,Y:Double;end;
  TMiningPath=record Time,X,Depth:Double;end;
  TMiningPulse=record Time,Strength:Double;Event:Integer;end;
  TMiningHit=record First,Time,Strength,X,Top,Bottom:Double;FirstPulse,LastPulse,Kind,Boss:Integer;end;
  TMiningEnemy=record First,Last,Hit,X,Y,Side:Double;Kind,Source:Integer;Ambient:Boolean;end;
  TMiningShot=record Launch,Impact,Finish,Radius:Double;A,B:TMiningPoint;Kind,Boss:Integer;Hit:Boolean;end;
  TMiningBoss=record Start,Kill,Finish:Double;FirstPulse,LastPulse:Integer;Purge:array[0..5] of Double;end;
  TMiningStratum=record Time:Double;Theme:Integer;end;
  TMiningPlan=class
  private
    FPath:TArray<TMiningPath>;FPulses:TArray<TMiningPulse>;FHits:TArray<TMiningHit>;
    FEnemies:TArray<TMiningEnemy>;FShots:TArray<TMiningShot>;FBosses:TArray<TMiningBoss>;FStrata:TArray<TMiningStratum>;
    FDuration,FSoundEnd,FEnd,FEntry:Double;FExcluded,FFrequency:Integer;
    procedure Verify;
    function GetCount:Integer;function GetPulseCount:Integer;function GetBossCount:Integer;
    function GetEnemyCount:Integer;function GetShotCount:Integer;
    function GetHit(I:Integer):TMiningHit;function GetPulse(I:Integer):TMiningPulse;
    function GetEnemy(I:Integer):TMiningEnemy;function GetShot(I:Integer):TMiningShot;function GetBoss(I:Integer):TMiningBoss;
  public
    class function Build(Audio:TRhythmAudio;const Cancel:TFunc<Boolean> = nil):TMiningPlan;static;
    procedure Save(var Ref:TRhythmPlanRef;Audio:TRhythmAudio);
    class function Load(const Ref:TRhythmPlanRef;Audio:TRhythmAudio;Direction:Integer):TMiningPlan;static;
    class function LoadAudioMetadata(const Ref:TRhythmPlanRef;const Source:string;Direction:Integer):TRhythmAudio;static;
    function ActorAt(Time:Double):TMiningPoint;
    function DepthAt(Time:Double):Double;
    function ZoomAt(Time:Double):Double;
    function ThemeAt(Time:Double):Integer;
    function PulseBefore(Time:Double):Integer;function HitBefore(Time:Double):Integer;
    function EnemyBefore(Time:Double):Integer;function ShotBefore(Time:Double):Integer;
    function EnemyAt(Index:Integer;Time:Double):TMiningPoint;
    function ShotAt(Index:Integer;Time:Double):TMiningPoint;
    function BossTop(Index:Integer;Time:Double):Double;
    function HealthAt(Index:Integer;Time:Double):Double;
    function HurtAt(Time:Double):Double;
    function SafeShot(const Shot:TMiningShot):Boolean;
    property Count:Integer read GetCount;property PulseCount:Integer read GetPulseCount;property BossCount:Integer read GetBossCount;
    property EnemyCount:Integer read GetEnemyCount;property ShotCount:Integer read GetShotCount;
    property Hit[I:Integer]:TMiningHit read GetHit;property Pulse[I:Integer]:TMiningPulse read GetPulse;
    property Enemy[I:Integer]:TMiningEnemy read GetEnemy;property Shot[I:Integer]:TMiningShot read GetShot;
    property Boss[I:Integer]:TMiningBoss read GetBoss;
    property EndTime:Double read FEnd;property SoundEnd:Double read FSoundEnd;property BossFrequency:Integer read FFrequency;
  end;
function MiningPoint(X,Y:Double):TMiningPoint;
function MiningHullDistance(const P,Actor:TMiningPoint):Double;
implementation
uses System.Math,System.JSON,System.Generics.Collections,System.Generics.Defaults,RhythmStyles,RhythmPreparedData,RhythmSections;
function MiningPoint(X,Y:Double):TMiningPoint;begin Result.X:=X;Result.Y:=Y;end;
function MiningHullDistance(const P,Actor:TMiningPoint):Double;
var Body,Bit:Double;
begin Body:=Hypot(Max(0.0,Abs(P.X-Actor.X)-0.112),Max(0.0,Abs(P.Y-Actor.Y)-0.076));
  Bit:=Hypot(Max(0.0,Abs(P.X-Actor.X)-MINING_HALF),Max(0.0,Max(Actor.Y+0.065-P.Y,P.Y-Actor.Y-MINING_TIP)));Result:=Min(Body,Bit);
end;
function Finite(V:Double):Boolean;begin Result:=not IsNan(V) and not IsInfinite(V);end;
function Smooth(U:Double):Double;begin U:=EnsureRange(U,0.0,1.0);Result:=U*U*(3-2*U);end;
function Lerp(const A,B:TMiningPoint;U:Double):TMiningPoint;begin Result:=MiningPoint(A.X+(B.X-A.X)*U,A.Y+(B.Y-A.Y)*U);end;
function TMiningPlan.GetCount:Integer;begin Result:=Length(FHits);end;
function TMiningPlan.GetPulseCount:Integer;begin Result:=Length(FPulses);end;
function TMiningPlan.GetBossCount:Integer;begin Result:=Length(FBosses);end;
function TMiningPlan.GetEnemyCount:Integer;begin Result:=Length(FEnemies);end;
function TMiningPlan.GetShotCount:Integer;begin Result:=Length(FShots);end;
function TMiningPlan.GetHit(I:Integer):TMiningHit;begin Result:=FHits[I];end;
function TMiningPlan.GetPulse(I:Integer):TMiningPulse;begin Result:=FPulses[I];end;
function TMiningPlan.GetEnemy(I:Integer):TMiningEnemy;begin Result:=FEnemies[I];end;
function TMiningPlan.GetShot(I:Integer):TMiningShot;begin Result:=FShots[I];end;
function TMiningPlan.GetBoss(I:Integer):TMiningBoss;begin Result:=FBosses[I];end;
function TMiningPlan.PulseBefore(Time:Double):Integer;
var A,B,M:Integer;begin A:=0;B:=PulseCount;while A<B do begin M:=(A+B) div 2;if FPulses[M].Time<=Time then A:=M+1 else B:=M;end;Result:=A-1;end;
function TMiningPlan.HitBefore(Time:Double):Integer;
var A,B,M:Integer;begin A:=0;B:=Count;while A<B do begin M:=(A+B) div 2;if FHits[M].Time<=Time then A:=M+1 else B:=M;end;Result:=A-1;end;
function TMiningPlan.EnemyBefore(Time:Double):Integer;
var A,B,M:Integer;begin A:=0;B:=EnemyCount;while A<B do begin M:=(A+B) div 2;if FEnemies[M].First<=Time then A:=M+1 else B:=M;end;Result:=A-1;end;
function TMiningPlan.ShotBefore(Time:Double):Integer;
var A,B,M:Integer;begin A:=0;B:=ShotCount;while A<B do begin M:=(A+B) div 2;if FShots[M].Launch<=Time then A:=M+1 else B:=M;end;Result:=A-1;end;
function TMiningPlan.DepthAt(Time:Double):Double;
var A,B,M:Integer;U:Double;
begin
  Result:=0;if Length(FPath)=0 then Exit;Time:=EnsureRange(Time,0.0,FSoundEnd);A:=0;B:=Length(FPath);
  while A<B do begin M:=(A+B) div 2;if FPath[M].Time<=Time then A:=M+1 else B:=M;end;A:=Max(0,A-1);
  if A=High(FPath) then Exit(FPath[A].Depth);U:=(Time-FPath[A].Time)/(FPath[A+1].Time-FPath[A].Time);
  Result:=FPath[A].Depth+(FPath[A+1].Depth-FPath[A].Depth)*U;
end;
function TMiningPlan.ActorAt(Time:Double):TMiningPoint;
var A,B,M:Integer;U:Double;
begin
  Result:=MiningPoint(0.8,0.42);if Length(FPath)=0 then Exit;Time:=EnsureRange(Time,0.0,FEnd);A:=0;B:=Length(FPath);
  while A<B do begin M:=(A+B) div 2;if FPath[M].Time<=Time then A:=M+1 else B:=M;end;A:=Max(0,A-1);
  Result.X:=FPath[A].X;if A<High(FPath) then begin U:=Smooth((Time-FPath[A].Time)/(FPath[A+1].Time-FPath[A].Time));Result.X:=Result.X+(FPath[A+1].X-Result.X)*U;end;
  Result.Y:=DepthAt(Time)+0.42;
  if (FEntry>0) and (Time<FEntry) then Result.Y:=Result.Y-0.72*(1-Smooth(Time/FEntry));
  if Time>FSoundEnd then Result.Y:=Result.Y+0.88*Smooth((Time-FSoundEnd)/1.1);
end;
function TMiningPlan.ZoomAt(Time:Double):Double;
var I:Integer;U,W:Double;
begin
  Time:=EnsureRange(Time,0.0,FEnd);U:=Frac(Time/8);Result:=0.98+0.065*Sqr(Sin(Pi*U));
  for I:=0 to BossCount-1 do if (Time>=FBosses[I].Start-0.5) and (Time<=FBosses[I].Kill+0.7) then begin
    W:=Smooth((Time-FBosses[I].Start+0.5)/1.0)*(1-Smooth((Time-FBosses[I].Kill)/0.7));Result:=Result+(0.90-Result)*W;Break;
  end;
end;
function TMiningPlan.ThemeAt(Time:Double):Integer;
var A,B,M:Integer;begin Result:=0;A:=0;B:=Length(FStrata);while A<B do begin M:=(A+B) div 2;if FStrata[M].Time<=Time then A:=M+1 else B:=M;end;if A>0 then Result:=FStrata[A-1].Theme;end;
function TMiningPlan.EnemyAt(Index:Integer;Time:Double):TMiningPoint;
var E:TMiningEnemy;A:TMiningPoint;U,Age:Double;
begin
  E:=FEnemies[Index];U:=EnsureRange((Time-E.First)/Max(1E-9,E.Hit-E.First),0.0,1.0);
  if E.Ambient then begin A:=ActorAt(Time);U:=EnsureRange((Time-E.First)/(E.Last-E.First),0.0,1.0);
    Result:=MiningPoint(A.X+E.Side*(0.25+0.12*Sin(Pi*U)),DepthAt(Time)+0.97-1.21*U);Exit;
  end;
  Result:=MiningPoint(E.X+E.Side*0.48*(1-Smooth(U)),E.Y+0.82*(1-U));
  if Time>E.Hit then begin Age:=Time-E.Hit;Result.X:=E.X+E.Side*Age*0.42;Result.Y:=E.Y+Age*0.34+Age*Age*0.45;end;
end;
function TMiningPlan.ShotAt(Index:Integer;Time:Double):TMiningPoint;
var S:TMiningShot;begin S:=FShots[Index];Result:=Lerp(S.A,S.B,EnsureRange((Time-S.Launch)/Max(1E-9,S.Impact-S.Launch),0.0,1.0));end;
function TMiningPlan.BossTop(Index:Integer;Time:Double):Double;
var B:TMiningBoss;P:TMiningPoint;I:Integer;A,Z,U,Gap:Double;
begin
  B:=FBosses[Index];P:=ActorAt(Time);A:=FPulses[B.FirstPulse].Time;Z:=FPulses[B.LastPulse].Time;Gap:=0;
  if Time<A then Gap:=0.36*(1-Smooth((Time-B.Start)/Max(0.01,A-B.Start)))
  else if Time<Z then begin I:=EnsureRange(PulseBefore(Time),B.FirstPulse,B.LastPulse-1);A:=FPulses[I].Time;Z:=FPulses[I+1].Time;
    U:=EnsureRange((Time-A)/Max(1E-9,Z-A),0.0,1.0);Gap:=0.032*Sqr(Sin(Pi*U));end;
  Result:=P.Y+MINING_TIP+Gap;
end;
function TMiningPlan.HealthAt(Index:Integer;Time:Double):Double;
var B:TMiningBoss;Taken,Total:Integer;
begin B:=FBosses[Index];Total:=B.LastPulse-B.FirstPulse+1;Taken:=EnsureRange(PulseBefore(Time)-B.FirstPulse+1,0,Total);Result:=1-Taken/Max(1,Total);end;
function TMiningPlan.HurtAt(Time:Double):Double;
var I:Integer;Age:Double;
begin Result:=0;for I:=Max(0,ShotBefore(Time-1.7)) to ShotBefore(Time) do if FShots[I].Hit then begin Age:=Time-FShots[I].Impact;if (Age>=0) and (Age<0.30) then Result:=Max(Result,Sin(Pi*Age/0.30));end;end;
function TMiningPlan.SafeShot(const Shot:TMiningShot):Boolean;
var I:Integer;T,U,D:Double;P,Q:TMiningPoint;
begin Result:=True;if Shot.Hit then Exit;
  for I:=0 to 96 do begin U:=I/96;T:=Shot.Launch+(Shot.Impact-Shot.Launch)*U;P:=Lerp(Shot.A,Shot.B,U);Q:=ActorAt(T);
    D:=MiningHullDistance(P,Q);if D<Shot.Radius+0.014 then Exit(False);
  end;
end;
class function TMiningPlan.Build(Audio:TRhythmAudio;const Cancel:TFunc<Boolean>):TMiningPlan;
var Paths:TList<TMiningPath>;Pulses:TList<TMiningPulse>;Hits:TList<TMiningHit>;Enemies:TList<TMiningEnemy>;Shots:TList<TMiningShot>;Bosses:TList<TMiningBoss>;Strata:TList<TMiningStratum>;
  I,J,K,N,First,Last,Wave,PerEnemy,Side:Integer;Time,Previous,Speed,Depth,Interval,NextWave,LastBoundary,Flight:Double;
  Key:TMiningPath;Pulse:TMiningPulse;H:TMiningHit;E:TMiningEnemy;B:TMiningBoss;Layer:TMiningStratum;Cue:TRhythmBossCue;A,Q:TMiningPoint;Accepted:Boolean;
  procedure Check;begin if Assigned(Cancel) and Cancel() then Abort;end;
  procedure AddShot(Origin:TMiningPoint;Launch,Impact:Double;Sign,Kind,Boss:Integer;Light:Boolean);
  var Trial:TMiningShot;Target,Point,Hero:TMiningPoint;Lo,Hi,T:Double;M,L:Integer;
  begin
    if (Impact<=Launch+0.08) or (Impact>Result.FSoundEnd+0.20) or (Shots.Count>=80000) then Exit;
    Trial:=Default(TMiningShot);Trial.Launch:=Launch;Trial.Impact:=Impact;Trial.Finish:=Impact+0.18;Trial.Radius:=0.010;Trial.A:=Origin;Trial.Kind:=Kind;Trial.Boss:=Boss;Target:=Result.ActorAt(Impact);
    if Light then begin
      Trial.Hit:=True;Trial.B:=MiningPoint(Target.X+Sign*0.085,Target.Y-0.015);Lo:=Launch;Hi:=Impact;
      for L:=1 to 32 do begin T:=Launch+(Impact-Launch)*L/32;Point:=Lerp(Trial.A,Trial.B,L/32);Hero:=Result.ActorAt(T);
        if MiningHullDistance(Point,Hero)<=Trial.Radius then begin Hi:=T;Break;end;Lo:=T;
      end;
      for L:=0 to 16 do begin T:=(Lo+Hi)/2;Point:=Lerp(Trial.A,Trial.B,(T-Launch)/(Impact-Launch));Hero:=Result.ActorAt(T);if MiningHullDistance(Point,Hero)<=Trial.Radius then Hi:=T else Lo:=T;end;
      Trial.B:=Lerp(Trial.A,Trial.B,(Hi-Launch)/(Impact-Launch));Trial.Impact:=Hi;Trial.Finish:=Hi+0.18;Shots.Add(Trial);Exit;
    end;
    for M:=0 to 4 do begin Trial.B:=MiningPoint(Target.X+Sign*(0.16+M*0.035),Target.Y+0.065);if Result.SafeShot(Trial) then begin Shots.Add(Trial);Exit;end;end;
  end;
begin
  if Audio=nil then raise EArgumentNilException.Create('Audio');
  if not Finite(Audio.Duration) or not Finite(Audio.SoundEnd) or (Audio.Duration<=0) or (Audio.SoundEnd<0) or (Audio.SoundEnd>Audio.Duration) or (Length(Audio.Hits)>100000) then raise Exception.Create('Invalid mining audio');
  Result:=TMiningPlan.Create;Paths:=TList<TMiningPath>.Create;Pulses:=TList<TMiningPulse>.Create;Hits:=TList<TMiningHit>.Create;
  Enemies:=TList<TMiningEnemy>.Create;Shots:=TList<TMiningShot>.Create;Bosses:=TList<TMiningBoss>.Create;Strata:=TList<TMiningStratum>.Create;
  try
   try
    Result.FDuration:=Audio.Duration;Result.FSoundEnd:=Audio.SoundEnd;Result.FFrequency:=Audio.BossFrequency;Result.FEnd:=0;if Audio.SoundEnd>0 then Result.FEnd:=Audio.SoundEnd+1.4;Previous:=-1;
    for I:=0 to High(Audio.Hits) do begin Check;Time:=Audio.Hits[I].Time;
      if not Finite(Time) or not Finite(Audio.Hits[I].Strength) or (Time<Previous) or (Time<0) or (Time>Audio.Duration+0.011) then raise Exception.Create('Mining accent order');Previous:=Time;
      if (Audio.SoundEnd<=0) or (Time>Audio.SoundEnd+1E-6) then begin Inc(Result.FExcluded);Continue;end;
      Pulse.Time:=Time;Pulse.Strength:=EnsureRange(Audio.Hits[I].Strength,0.0,1.0);
      if Hits.Count>0 then begin H:=Hits[Hits.Count-1];Accepted:=(Time-H.Time<0.075) and (Time-H.First<=0.16+1E-9);end else Accepted:=False;
      if Accepted then begin H.Time:=Time;H.LastPulse:=Pulses.Count;H.Strength:=Max(H.Strength,Pulse.Strength);Hits[Hits.Count-1]:=H;end
      else begin if Hits.Count>=20000 then raise Exception.Create('Too many mining contacts');H:=Default(TMiningHit);H.First:=Time;H.Time:=Time;H.FirstPulse:=Pulses.Count;H.LastPulse:=Pulses.Count;H.Strength:=Pulse.Strength;H.Boss:=-1;Hits.Add(H);end;
      Pulse.Event:=Hits.Count-1;Pulses.Add(Pulse);
    end;Result.FPulses:=Pulses.ToArray;Result.FHits:=Hits.ToArray;Result.FEntry:=0;
    if Result.PulseCount>0 then Result.FEntry:=Min(0.60,Result.FPulses[0].Time*0.70);
    Depth:=0;Previous:=0;
    for I:=0 to Max(1,Ceil(Result.FEnd*4)) do begin Check;Time:=Min(Result.FEnd,I*0.25);
      if (I>0) and (Time<=Previous) then Break;Speed:=0.64+0.26*Sqr(Sin(Time*0.31));if (Floor(Time/9) mod 3=1) then Speed:=Speed+0.45*Sqr(Sin(Pi*Frac(Time/9)));
      Depth:=Depth+(Time-Previous)*Speed;Key.Time:=Time;Key.Depth:=Depth;Key.X:=EnsureRange(0.8+0.21*Sin(Time*0.43)+0.085*Sin(Time*1.17),0.46,1.14);Paths.Add(Key);Previous:=Time;
    end;Result.FPath:=Paths.ToArray;
    for I:=0 to Result.Count-1 do begin H:=Result.FHits[I];A:=Result.ActorAt(H.First);Q:=Result.ActorAt(H.Time);H.X:=Q.X;H.Top:=A.Y+MINING_TIP;H.Bottom:=Q.Y+MINING_TIP+0.042;
      H.Kind:=I mod 3;if (H.Strength>0.75) and (I mod 7=3) then H.Kind:=3;Result.FHits[I]:=H;
    end;
    for I:=0 to Audio.BossCount-1 do begin Check;if Bosses.Count>=64 then Break;Cue:=Audio.BossCue(I);First:=Result.HitBefore(Cue.StartTime+0.80)+1;Last:=Result.HitBefore(Cue.KillTime);
      if (First<0) or (Last<First+4) or (Last>=Result.Count) or (Result.FHits[Last].Time-Cue.StartTime<5) then Continue;
      B:=Default(TMiningBoss);B.Start:=Cue.StartTime;B.Kill:=Result.FHits[Last].Time;B.Finish:=B.Kill+0.75;B.FirstPulse:=Result.FHits[First].FirstPulse;B.LastPulse:=Result.FHits[Last].LastPulse;
      for J:=0 to 5 do begin K:=B.FirstPulse+Floor((B.LastPulse-B.FirstPulse)*(J+1)/6);B.Purge[J]:=Result.FPulses[K].Time;end;
      for J:=First to Last do begin H:=Result.FHits[J];H.Boss:=Bosses.Count;Result.FHits[J]:=H;end;Bosses.Add(B);
    end;Result.FBosses:=Bosses.ToArray;
    Layer.Time:=0;Layer.Theme:=0;Strata.Add(Layer);LastBoundary:=-10;
    for I:=4 to Floor(Audio.SoundEnd*2)-2 do begin Time:=I*0.5;
      if (Time-LastBoundary>=8) and (Audio.LevelAt(Time-0.5)>0.50) and (Audio.LevelAt(Time+0.5)<0.20) then begin Layer.Time:=Time;Layer.Theme:=Strata.Count mod 4;Strata.Add(Layer);LastBoundary:=Time;end;
    end;Result.FStrata:=Strata.ToArray;
    Interval:=Max(0.70,Audio.SoundEnd*7/9000);NextWave:=1.1;Wave:=0;
    for I:=0 to Result.Count-1 do begin Check;H:=Result.FHits[I];if (H.Time<NextWave) or (H.Time>Audio.SoundEnd-0.15) then Continue;
      N:=4;if H.Strength>=0.75 then N:=7;A:=Result.ActorAt(H.Time);
      for J:=0 to N-1 do begin if Enemies.Count>=12000 then Break;E:=Default(TMiningEnemy);E.Hit:=H.Time;E.First:=Max(0.0,E.Hit-2.4);E.Last:=Min(Result.FEnd,E.Hit+0.46);E.X:=A.X+(J-(N-1)/2)*0.032;E.Y:=A.Y+MINING_TIP+0.025;E.Side:=J mod 2*2-1;E.Kind:=(Wave+J) mod 3;E.Source:=I;Enemies.Add(E);end;
      Inc(Wave);NextWave:=H.Time+Interval;
    end;
    Interval:=Max(0.75,Audio.SoundEnd*2/2600);I:=0;Time:=0.45;
    while (Time<Audio.SoundEnd-0.65) and (Enemies.Count<14000) do begin Check;
      for Side:=-1 to 1 do if Side<>0 then begin E:=Default(TMiningEnemy);E.First:=Time;E.Hit:=Time+2.4;E.Last:=Min(Audio.SoundEnd+0.3,E.Hit);E.Ambient:=True;E.Side:=Side;E.Kind:=I mod 3;E.Source:=-1;Enemies.Add(E);end;
      Inc(I);Time:=Time+Interval;
    end;
    Result.FEnemies:=Enemies.ToArray;TArray.Sort<TMiningEnemy>(Result.FEnemies,TComparer<TMiningEnemy>.Construct(function(const A,B:TMiningEnemy):Integer begin Result:=0;if A.First<B.First then Exit(-1);if A.First>B.First then Exit(1);if A.X<B.X then Result:=-1 else if A.X>B.X then Result:=1;end));
    PerEnemy:=Min(6,Max(2,40000 div Max(1,Result.EnemyCount)));
    for I:=0 to Result.EnemyCount-1 do begin Check;E:=Result.FEnemies[I];
      for J:=0 to PerEnemy-1 do begin Time:=E.First+0.18+J*0.19;if Time>E.Hit-0.25 then Break;A:=Result.EnemyAt(I,Time);Side:=1;if (I+J) mod 2=0 then Side:=-1;
        AddShot(A,Time,Time+0.62,Side,E.Kind,-1,((I*3+J) mod 83=29));
      end;
    end;
    for I:=0 to Result.BossCount-1 do begin B:=Result.FBosses[I];Interval:=Max(0.40,(B.Kill-B.Start)*14/Max(1,38000 div Max(1,Result.BossCount)));Time:=B.Start+1.0;J:=0;
      while Time<B.Kill-0.3 do begin Check;A:=Result.ActorAt(Time);N:=7;if Time>B.Purge[2] then N:=13;
        for K:=0 to N-1 do begin Side:=K mod 2*2-1;Q:=MiningPoint(A.X+(K-(N-1)/2)*0.040,Result.BossTop(I,Time)+0.055);AddShot(Q,Time,Time+0.55+0.035*(K mod 3),Side,(J div 3) mod 3,I,((J+K) mod 53=17));end;
        Inc(J);Time:=Time+Interval;
      end;
    end;
    Time:=7.5;I:=0;while Time<Audio.SoundEnd-0.5 do begin Check;J:=Audio.NearestHit(Time);if (J>=0) and (Audio.Hits[J].Time<Audio.SoundEnd-0.15) then begin
      Flight:=Audio.Hits[J].Time;A:=Result.ActorAt(Flight);Side:=I mod 2*2-1;Q:=MiningPoint(A.X+Side*0.08,A.Y-0.85);
      AddShot(Q,Max(0.0,Flight-0.68),Flight,Side,3,-1,I mod 3=1);
    end;Inc(I);Time:=Time+9;end;
    Result.FShots:=Shots.ToArray;TArray.Sort<TMiningShot>(Result.FShots,TComparer<TMiningShot>.Construct(function(const A,B:TMiningShot):Integer begin Result:=0;if A.Launch<B.Launch then Exit(-1);if A.Launch>B.Launch then Exit(1);if A.Impact<B.Impact then Result:=-1 else if A.Impact>B.Impact then Result:=1;end));Result.Verify;
   except Result.Free;Result:=nil;raise;end;
  finally Paths.Free;Pulses.Free;Hits.Free;Enemies.Free;Shots.Free;Bosses.Free;Strata.Free;end;
end;
procedure TMiningPlan.Verify;
var I,J,N:Integer;H:TMiningHit;E:TMiningEnemy;S:TMiningShot;B:TMiningBoss;P:TMiningPoint;
  procedure Need(V:Boolean;const Why:string);begin if not V then raise Exception.Create('Mining plan: '+Why);end;
begin
  Need(Finite(FDuration) and Finite(FSoundEnd) and Finite(FEnd) and (FDuration>0) and (FSoundEnd>=0) and (FSoundEnd<=FDuration),'bounds');
  Need(Finite(FEntry) and (FEntry>=0) and (FEntry<=0.60) and (FExcluded>=0),'entry');
  Need(((FSoundEnd=0) and (FEnd=0)) or ((FSoundEnd>0) and (Abs(FEnd-FSoundEnd-1.4)<1E-7)),'ending');
  Need((Count<=20000) and (PulseCount<=100000) and (BossCount<=64) and (EnemyCount<=14000) and (ShotCount<=80000) and (Length(FPath)<=13000) and (Length(FStrata)<=2048),'limits');
  Need((FFrequency>=0) and (FFrequency<=100) and ((FFrequency<>0) or (BossCount=0)),'frequency');
  for I:=0 to High(FPath) do begin Need(Finite(FPath[I].Time) and Finite(FPath[I].X) and Finite(FPath[I].Depth),'path finite');Need((FPath[I].X>=0.4) and (FPath[I].X<=1.2),'path x');if I>0 then Need((FPath[I].Time>FPath[I-1].Time) and (FPath[I].Depth>FPath[I-1].Depth),'forward motion');end;
  Need((Length(FPath)>0) and (FPath[0].Time=0) and (FPath[High(FPath)].Time=FEnd),'path span');
  for I:=0 to PulseCount-1 do begin Need(Finite(FPulses[I].Time) and Finite(FPulses[I].Strength),'pulse finite');Need((FPulses[I].Time>=0) and (FPulses[I].Time<=FSoundEnd+1E-6) and (FPulses[I].Event>=0) and (FPulses[I].Event<Count),'pulse link');if I>0 then Need(FPulses[I].Time>=FPulses[I-1].Time,'pulse order');end;
  N:=0;for I:=0 to Count-1 do begin H:=FHits[I];Need((H.FirstPulse=N) and (H.LastPulse>=N) and (H.LastPulse<PulseCount),'group cover');N:=H.LastPulse+1;
    Need(Finite(H.X) and Finite(H.Top) and Finite(H.Bottom) and Finite(H.Strength) and (H.Kind>=0) and (H.Kind<=3) and (H.Boss>=-1) and (H.Boss<BossCount),'material');
    Need((H.First=FPulses[H.FirstPulse].Time) and (H.Time=FPulses[H.LastPulse].Time),'audio clock');P:=ActorAt(H.Time);Need((Abs(P.X-H.X)<1E-7) and (Abs(P.Y+MINING_TIP+0.042-H.Bottom)<1E-7),'drill contact');
    P:=ActorAt(H.First);Need(Abs(P.Y+MINING_TIP-H.Top)<1E-7,'first face');Need(H.Bottom>=H.Top,'cut volume');for J:=H.FirstPulse to H.LastPulse do Need(FPulses[J].Event=I,'pulse event map');
  end;Need(N=PulseCount,'all accents');
  for I:=0 to EnemyCount-1 do begin E:=FEnemies[I];Need(Finite(E.First) and Finite(E.Hit) and Finite(E.Last) and (E.First>=0) and (E.Last>E.First) and (E.Last<=FEnd+1E-7),'enemy interval');if I>0 then Need(E.First>=FEnemies[I-1].First,'enemy order');
    if not E.Ambient then begin Need((E.Source>=0) and (E.Source<Count) and (E.Hit=FHits[E.Source].Time),'enemy source');P:=ActorAt(E.Hit);Need((Abs(E.Y-0.025-P.Y-MINING_TIP)<1E-7) and (Abs(E.X-P.X)+0.024<=MINING_HALF+1E-7),'enemy drill face');end;
  end;
  for I:=0 to ShotCount-1 do begin S:=FShots[I];Need(Finite(S.Launch) and Finite(S.Impact) and Finite(S.Finish) and Finite(S.Radius) and Finite(S.A.X) and Finite(S.A.Y) and Finite(S.B.X) and Finite(S.B.Y),'shot finite');Need((S.Launch>=0) and (S.Impact>S.Launch+0.02) and (S.Finish>S.Impact) and (S.Finish<=FEnd+1E-7) and (S.Radius>0) and (S.Radius<=0.04) and (S.Boss>=-1) and (S.Boss<BossCount),'shot interval');if I>0 then Need(S.Launch>=FShots[I-1].Launch,'shot order');Need(SafeShot(S),'unexpected collision');
    if S.Hit then begin P:=ActorAt(S.Impact);Need(Abs(MiningHullDistance(S.B,P)-S.Radius)<0.001,'armor hit contact');end;
  end;
  for I:=0 to BossCount-1 do begin B:=FBosses[I];Need((B.Start>=0) and (B.Kill>B.Start+4.5) and (B.Finish<=FEnd+1E-7) and (B.FirstPulse>=0) and (B.LastPulse<PulseCount) and (B.LastPulse>B.FirstPulse),'boss interval');Need(B.Kill=FPulses[B.LastPulse].Time,'boss kill clock');
    if I>0 then Need(B.Start>=FBosses[I-1].Finish,'boss separation');
    for J:=0 to 5 do begin Need((B.Purge[J]>=FPulses[B.FirstPulse].Time) and (B.Purge[J]<=B.Kill),'purge interval');if J>0 then Need(B.Purge[J]>=B.Purge[J-1],'purge order');end;
    for J:=B.FirstPulse to B.LastPulse do begin P:=ActorAt(FPulses[J].Time);Need(Abs(BossTop(I,FPulses[J].Time)-P.Y-MINING_TIP)<1E-7,'boss face contact');end;
  end;
  for I:=0 to High(FStrata) do begin Need(Finite(FStrata[I].Time) and (FStrata[I].Time>=0) and (FStrata[I].Time<=FSoundEnd) and (FStrata[I].Theme>=0) and (FStrata[I].Theme<=3),'stratum');if I>0 then Need(FStrata[I].Time>FStrata[I-1].Time,'stratum order');end;
end;
procedure TMiningPlan.Save(var Ref:TRhythmPlanRef;Audio:TRhythmAudio);
var Root,J:TJSONObject;A,Parts:TJSONArray;K:TMiningPath;P:TMiningPulse;H:TMiningHit;E:TMiningEnemy;S:TMiningShot;B:TMiningBoss;L:TMiningStratum;I:Integer;
begin
  if not Ref.Matches(Audio.Key,Audio.Sensitivity,Ref.Direction,rsMining,Ref.Variant) or (Ref.Version<>1) or (BossFrequencyFromVariant(Ref.Variant)<>FFrequency) then raise Exception.Create('Mining reference');
  Root:=TJSONObject.Create;try
    Root.AddPair('schema',TJSONNumber.Create(1));Root.AddPair('style','mining');Root.AddPair('version',TJSONNumber.Create(1));Root.AddPair('key',Ref.Key);Root.AddPair('source',Ref.SourceKey);Root.AddPair('sensitivity',TJSONNumber.Create(Ref.Sensitivity));Root.AddPair('direction',TJSONNumber.Create(Ref.Direction));AddPreparedAudio(Root,Audio);
    Root.AddPair('policy','drill-contact-v1');Root.AddPair('end',TJSONNumber.Create(FEnd));Root.AddPair('entry',TJSONNumber.Create(FEntry));Root.AddPair('excluded',TJSONNumber.Create(FExcluded));Root.AddPair('frequency',TJSONNumber.Create(FFrequency));
    A:=TJSONArray.Create;Root.AddPair('path',A);for K in FPath do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('t',TJSONNumber.Create(K.Time));J.AddPair('x',TJSONNumber.Create(K.X));J.AddPair('d',TJSONNumber.Create(K.Depth));end;
    A:=TJSONArray.Create;Root.AddPair('pulses',A);for P in FPulses do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('t',TJSONNumber.Create(P.Time));J.AddPair('s',TJSONNumber.Create(P.Strength));J.AddPair('event',TJSONNumber.Create(P.Event));end;
    A:=TJSONArray.Create;Root.AddPair('hits',A);for H in FHits do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('first',TJSONNumber.Create(H.First));J.AddPair('t',TJSONNumber.Create(H.Time));J.AddPair('s',TJSONNumber.Create(H.Strength));J.AddPair('x',TJSONNumber.Create(H.X));J.AddPair('top',TJSONNumber.Create(H.Top));J.AddPair('bottom',TJSONNumber.Create(H.Bottom));J.AddPair('p0',TJSONNumber.Create(H.FirstPulse));J.AddPair('p1',TJSONNumber.Create(H.LastPulse));J.AddPair('kind',TJSONNumber.Create(H.Kind));J.AddPair('boss',TJSONNumber.Create(H.Boss));end;
    A:=TJSONArray.Create;Root.AddPair('enemies',A);for E in FEnemies do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('first',TJSONNumber.Create(E.First));J.AddPair('last',TJSONNumber.Create(E.Last));J.AddPair('hit',TJSONNumber.Create(E.Hit));J.AddPair('x',TJSONNumber.Create(E.X));J.AddPair('y',TJSONNumber.Create(E.Y));J.AddPair('side',TJSONNumber.Create(E.Side));J.AddPair('kind',TJSONNumber.Create(E.Kind));J.AddPair('source',TJSONNumber.Create(E.Source));J.AddPair('ambient',TJSONBool.Create(E.Ambient));end;
    A:=TJSONArray.Create;Root.AddPair('shots',A);for S in FShots do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('launch',TJSONNumber.Create(S.Launch));J.AddPair('impact',TJSONNumber.Create(S.Impact));J.AddPair('finish',TJSONNumber.Create(S.Finish));J.AddPair('radius',TJSONNumber.Create(S.Radius));J.AddPair('ax',TJSONNumber.Create(S.A.X));J.AddPair('ay',TJSONNumber.Create(S.A.Y));J.AddPair('bx',TJSONNumber.Create(S.B.X));J.AddPair('by',TJSONNumber.Create(S.B.Y));J.AddPair('kind',TJSONNumber.Create(S.Kind));J.AddPair('boss',TJSONNumber.Create(S.Boss));J.AddPair('hit',TJSONBool.Create(S.Hit));end;
    A:=TJSONArray.Create;Root.AddPair('bosses',A);for B in FBosses do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('start',TJSONNumber.Create(B.Start));J.AddPair('kill',TJSONNumber.Create(B.Kill));J.AddPair('finish',TJSONNumber.Create(B.Finish));J.AddPair('p0',TJSONNumber.Create(B.FirstPulse));J.AddPair('p1',TJSONNumber.Create(B.LastPulse));Parts:=TJSONArray.Create;J.AddPair('purge',Parts);for I:=0 to 5 do Parts.AddElement(TJSONNumber.Create(B.Purge[I]));end;
    A:=TJSONArray.Create;Root.AddPair('strata',A);for L in FStrata do begin J:=TJSONObject.Create;A.AddElement(J);J.AddPair('t',TJSONNumber.Create(L.Time));J.AddPair('theme',TJSONNumber.Create(L.Theme));end;WritePreparedData(Root,Ref);
  finally Root.Free;end;
end;
class function TMiningPlan.LoadAudioMetadata(const Ref:TRhythmPlanRef;const Source:string;Direction:Integer):TRhythmAudio;
var Root,J:TJSONObject;A:TJSONArray;I:Integer;
begin
  Root:=ReadPreparedData(Ref,rsMining,Direction);try Result:=PreparedAudio(Root,Ref,Source);
    try A:=Root.GetValue<TJSONArray>('pulses');if (A=nil) or (A.Count>Length(Result.Hits)) then raise Exception.Create('Mining metadata pulses');
      for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;Result.Hits[I].Time:=J.GetValue<Double>('t');Result.Hits[I].Strength:=J.GetValue<Double>('s');end;Result.SetBossFrequency(BossFrequencyFromVariant(Ref.Variant));
    except Result.Free;raise;end;
  finally Root.Free;end;
end;
class function TMiningPlan.Load(const Ref:TRhythmPlanRef;Audio:TRhythmAudio;Direction:Integer):TMiningPlan;
var Root,J,Info:TJSONObject;A,P:TJSONArray;I,K:Integer;
  function Items(const Name:string;Limit:Integer):TJSONArray;
  begin Result:=Root.GetValue<TJSONArray>(Name);if (Result=nil) or (Result.Count>Limit) then raise Exception.Create('Mining array '+Name);end;
begin
  if (Audio=nil) or not Ref.Matches(Audio.Key,Audio.Sensitivity,Direction,rsMining,Ref.Variant) then raise Exception.Create('Mining settings');Root:=ReadPreparedData(Ref,rsMining,Direction);
  try
    Info:=Root.GetValue<TJSONObject>('audio');if (Info=nil) or (Root.GetValue<string>('policy','')<>'drill-contact-v1') or (Abs(Info.GetValue<Double>('duration')-Audio.Duration)>1E-7) or (Abs(Info.GetValue<Double>('soundEnd')-Audio.SoundEnd)>1E-7) or (Info.GetValue<Integer>('events')<>Length(Audio.Hits)) then raise Exception.Create('Mining audio identity');
    Result:=TMiningPlan.Create;
    try Result.FDuration:=Audio.Duration;Result.FSoundEnd:=Audio.SoundEnd;Result.FEnd:=Root.GetValue<Double>('end');Result.FEntry:=Root.GetValue<Double>('entry');Result.FExcluded:=Root.GetValue<Integer>('excluded');Result.FFrequency:=Root.GetValue<Integer>('frequency');if Result.FFrequency<>BossFrequencyFromVariant(Ref.Variant) then raise Exception.Create('Mining frequency');
      A:=Items('path',13000);SetLength(Result.FPath,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;Result.FPath[I].Time:=J.GetValue<Double>('t');Result.FPath[I].X:=J.GetValue<Double>('x');Result.FPath[I].Depth:=J.GetValue<Double>('d');end;
      A:=Items('pulses',100000);SetLength(Result.FPulses,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;Result.FPulses[I].Time:=J.GetValue<Double>('t');Result.FPulses[I].Strength:=J.GetValue<Double>('s');Result.FPulses[I].Event:=J.GetValue<Integer>('event');end;if A.Count+Result.FExcluded<>Length(Audio.Hits) then raise Exception.Create('Mining event coverage');
      A:=Items('hits',20000);SetLength(Result.FHits,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;with Result.FHits[I] do begin First:=J.GetValue<Double>('first');Time:=J.GetValue<Double>('t');Strength:=J.GetValue<Double>('s');X:=J.GetValue<Double>('x');Top:=J.GetValue<Double>('top');Bottom:=J.GetValue<Double>('bottom');FirstPulse:=J.GetValue<Integer>('p0');LastPulse:=J.GetValue<Integer>('p1');Kind:=J.GetValue<Integer>('kind');Boss:=J.GetValue<Integer>('boss');end;end;
      A:=Items('enemies',14000);SetLength(Result.FEnemies,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;with Result.FEnemies[I] do begin First:=J.GetValue<Double>('first');Last:=J.GetValue<Double>('last');Hit:=J.GetValue<Double>('hit');X:=J.GetValue<Double>('x');Y:=J.GetValue<Double>('y');Side:=J.GetValue<Double>('side');Kind:=J.GetValue<Integer>('kind');Source:=J.GetValue<Integer>('source');Ambient:=J.GetValue<Boolean>('ambient');end;end;
      A:=Items('shots',80000);SetLength(Result.FShots,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;with Result.FShots[I] do begin Launch:=J.GetValue<Double>('launch');Impact:=J.GetValue<Double>('impact');Finish:=J.GetValue<Double>('finish');Radius:=J.GetValue<Double>('radius');Result.FShots[I].A:=MiningPoint(J.GetValue<Double>('ax'),J.GetValue<Double>('ay'));Result.FShots[I].B:=MiningPoint(J.GetValue<Double>('bx'),J.GetValue<Double>('by'));Kind:=J.GetValue<Integer>('kind');Boss:=J.GetValue<Integer>('boss');Hit:=J.GetValue<Boolean>('hit');end;end;
      A:=Items('bosses',64);SetLength(Result.FBosses,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;with Result.FBosses[I] do begin Start:=J.GetValue<Double>('start');Kill:=J.GetValue<Double>('kill');Finish:=J.GetValue<Double>('finish');FirstPulse:=J.GetValue<Integer>('p0');LastPulse:=J.GetValue<Integer>('p1');P:=J.GetValue<TJSONArray>('purge');if (P=nil) or (P.Count<>6) then raise Exception.Create('Mining purge');for K:=0 to 5 do Purge[K]:=P.Items[K].GetValue<Double>;end;end;
      A:=Items('strata',2048);SetLength(Result.FStrata,A.Count);for I:=0 to A.Count-1 do begin J:=A.Items[I] as TJSONObject;Result.FStrata[I].Time:=J.GetValue<Double>('t');Result.FStrata[I].Theme:=J.GetValue<Integer>('theme');end;Result.Verify;
    except Result.Free;raise;end;
  finally Root.Free;end;
end;
end.
