unit RhythmRaceCrashCodec;
// v8/v9 binary64 JSONと保存済み幾何の前向き検証。逆算や音時刻修正をしない。
interface
uses System.SysUtils,System.JSON,RhythmAudio,RhythmRaceCrashMotion;
function CrashFinite(V:Double):Boolean;
procedure CrashRequire(V:Boolean;const Why:string);
// 保存と復元は同じ配列順序／浮動小数点ビット列を維持する。
function RaceCrashJSON(Plan:TRaceCrashMotion):TJSONObject;
procedure ReadRaceCrashJSON(Plan:TRaceCrashMotion;Root:TJSONObject;Audio:TRhythmAudio);
procedure ValidateRaceCrashPlan(Plan:TRaceCrashMotion;const Cancel:TFunc<Boolean>);
implementation
uses System.Math,RhythmRaceTrafficContacts;

function CrashFinite(V:Double):Boolean;
begin Result:=not IsNan(V) and not IsInfinite(V);
end;

procedure CrashRequire(V:Boolean;const Why:string);
begin if not V then raise Exception.Create('Race crash: '+Why);
end;

procedure ValidateRaceCrashPlan(Plan:TRaceCrashMotion;const Cancel:TFunc<Boolean>);
var
  I,J:Integer;
  Last,T,LaneLow,LaneHigh,Gap,Z:Double;
  H:TCrashHit;
  E:TCrashEnemy;
  V:TCrashTraffic;
  P:TCrashPose;
  K:TCrashKey;
  procedure Check;
  begin if Assigned(Cancel) and Cancel() then Abort;
  end;
begin
  with Plan do begin
    CrashRequire((Version=8) or (Version=9) or (Version=10),'version');
    CrashRequire(CrashFinite(Duration) and (Duration>0) and (Duration<=CRASH_MAX_SECONDS) and CrashFinite(SoundEnd) and (SoundEnd>=0) and (SoundEnd<=Duration) and CrashFinite(EndTime) and (EndTime>0) and (EndTime<=Duration),'duration');
    if SoundEnd>0 then CrashRequire(Abs(EndTime-SoundEnd)<1E-7,'audible end') else CrashRequire(EndTime=Duration,'silent end');
    CrashRequire((Frequency>=0) and (Frequency<=100) and CrashFinite(Launch) and CrashFinite(Acceleration) and CrashFinite(Goal) and CrashFinite(TopSpeed) and (Launch>=0) and (Acceleration>0) and (Launch+Acceleration<Goal) and (Goal<EndTime) and (TopSpeed>=135) and (TopSpeed<=159),'timeline');
    CrashRequire((Length(Events)<=100000) and (Length(Hits)<=Length(Events)) and (Length(Enemies)<=40000) and (Length(Traffic)<=24000) and (Length(Bosses)<=64) and (Length(Keys)>=2) and (Length(Keys)<=40000) and (Length(Road)>=2) and (Length(Road)<=2000),'limits');
    if Frequency=0 then CrashRequire(Length(Bosses)=0,'boss disabled');
    CrashRequire((Keys[0].Time=0) and (Keys[High(Keys)].Time=EndTime) and (Road[0].Time=0) and (Road[High(Road)].Time>=DistanceAt(EndTime)+1200),'coverage');
    Last:=-1;
    for K in Keys do begin CrashRequire(CrashFinite(K.Time) and CrashFinite(K.Value) and (K.Time>Last) and (Abs(K.Value)<=0.48+1E-8),'lane keys');
      Last:=K.Time;
    end;
    for I:=1 to High(Keys) do CrashRequire(1.5*Abs(Keys[I].Value-Keys[I-1].Value)/(Keys[I].Time-Keys[I-1].Time)<=0.975+1E-8,'lane speed');
    Last:=-1;
    for K in Road do begin CrashRequire(CrashFinite(K.Time) and CrashFinite(K.Value) and (K.Time>Last) and (Abs(K.Value)<=0.28),'road keys');
      Last:=K.Time;
    end;
    Last:=-1;
    for I:=0 to High(Events) do begin Check;
      CrashRequire(CrashFinite(Events[I].Time) and CrashFinite(Events[I].Strength) and (Events[I].Time>=Last) and (Events[I].Time>=0) and (Events[I].Time<=Duration+0.011),'source event');
      Last:=Events[I].Time;
    end;
    Last:=-1;
    for I:=0 to High(Enemies) do begin Check;
      E:=Enemies[I];
      CrashRequire((E.First>=0) and (E.Last>=E.First) and (E.Last<Length(Hits)) and (E.Kind in [0,1,2,3,4,5,6]) and ((E.Side=-1) or (E.Side=0) or (E.Side=1)) and (E.Boss>=-1) and (E.Boss<Length(Bosses)) and CrashFinite(E.Speed) and (E.Speed>=0) and CrashFinite(E.Width) and (E.Width>=0.12) and (E.Width<=0.44) and CrashFinite(E.HalfLength) and (E.HalfLength>=6) and (E.HalfLength<=32),'enemy body');
      CrashRequire(CrashFinite(E.Spawn) and CrashFinite(E.Ready) and CrashFinite(E.Kill) and CrashFinite(E.Clear) and (E.Spawn>=0) and (E.Spawn<E.Ready) and (E.Ready=Hits[E.First].Time) and (E.Kill=Hits[E.Last].Time) and (E.Clear>E.Kill) and (E.Clear<=EndTime) and (E.Ready>=Last),'enemy clocks');
      Last:=E.Ready;
      if I=0 then CrashRequire(E.First=0,'first enemy coverage') else CrashRequire((E.First=Enemies[I-1].Last+1) and (E.Kill>=Enemies[I-1].Kill),'enemy partition');
      if I=High(Enemies) then CrashRequire(E.Last=High(Hits),'last enemy coverage');
      if E.Side<>0 then begin LaneBounds(E.Spawn,E.Kill,LaneLow,LaneHigh);
        Gap:=HeroWidth+2*E.Width+0.04;
        if E.Side>0 then CrashRequire(LaneHigh+Gap<=0.999+1E-8,'side ram road') else CrashRequire(LaneLow-Gap>=-0.999-1E-8,'side ram road');
      end;
    end;
    Last:=-1;
    for I:=0 to High(Hits) do begin Check;
      H:=Hits[I];
      CrashRequire((H.Source>=0) and (H.Source<Length(Events)) and (H.Enemy>=0) and (H.Enemy<Length(Enemies)),'impact links');
      E:=Enemies[H.Enemy];
      CrashRequire(CrashFinite(H.Time) and CrashFinite(H.Strength) and CrashFinite(H.Distance) and CrashFinite(H.Lane) and (H.Time>=Last) and (H.Time=Events[H.Source].Time) and (H.Strength=EnsureRange(Events[H.Source].Strength,0.0,1.0)) and (H.Time>=Launch+0.60*Acceleration) and (H.Time<Goal) and (I>=E.First) and (I<=E.Last) and (H.HP=E.Last-I),'impact source/HP');
      Last:=H.Time;
      P:=EnemyAt(H.Enemy,H.Time);
      if E.Side=0 then begin CrashRequire(Abs(P.Distance-E.HalfLength-DistanceAt(H.Time)-HeroFront)<1E-6,'front bumper contact');
        CrashRequire(Abs(P.Lane-LaneAt(H.Time))<1E-7,'front lane contact');
      end else CrashRequire(Abs(Abs(P.Lane-LaneAt(H.Time))-HeroWidth-E.Width)<1E-7,'side fender contact');
      CrashRequire((Abs(H.Lane-(LaneAt(H.Time)+E.Side*HeroWidth))<1E-7),'saved contact lane');
      T:=3;
      if E.Side=0 then T:=HeroFront;
      CrashRequire(Abs(H.Distance-DistanceAt(H.Time)-T)<1E-6,'saved contact distance');
    end;
    Last:=-1;
    for I:=0 to High(Traffic) do begin Check;
      V:=Traffic[I];
      CrashRequire(CrashFinite(V.Spawn) and CrashFinite(V.Clear) and CrashFinite(V.Pass) and (V.Spawn>=Launch) and (V.Spawn<V.Pass) and (V.Pass<V.Clear) and (V.Clear<=EndTime) and (V.Pass>=Last) and (V.Kind in [0,1,2,3]) and CrashFinite(V.RelativeSpeed) and (V.RelativeSpeed>=65) and (V.RelativeSpeed<=170) and CrashFinite(V.Gap) and (V.Gap>=0.018) and (V.Gap<=0.031) and CrashFinite(V.FarLane) and CrashFinite(V.Width) and (V.Width>=0.085) and (V.Width<=0.20) and CrashFinite(V.HalfLength) and (V.HalfLength>=4.5) and (V.HalfLength<=14),'traffic data');
      Last:=V.Pass;
      CrashRequire(TrafficCertified(I),'whole-interval traffic certificate');
      P:=TrafficRoadAt(I,V.Pass);
      CrashRequire((Abs(P.Distance-DistanceAt(V.Pass))<1E-7) and (Abs(P.Lane-LaneAt(V.Pass))-HeroWidth-P.Width>=V.Gap-1E-8),'close pass');
      for J:=0 to 32 do begin T:=V.Spawn+(V.Clear-V.Spawn)*J/32;
        P:=TrafficAt(I,T);
        Z:=P.Distance-DistanceAt(T);
        Gap:=TrafficClearance(I,T);
        if P.Alive then CrashRequire((P.Lane-P.Width>=-1-1E-8) and (P.Lane+P.Width<=1+1E-8),'traffic road');
        if (Version<10) and P.Alive and (Gap<=0) then CrashRequire(Abs(Z)>=Max(HeroFront,HeroBack)+V.HalfLength+2-1E-6,'traffic interval guard');
        CrashRequire(not ((Z-V.HalfLength<HeroFront) and (Z+V.HalfLength> -HeroBack) and (Gap<=0)),'traffic body collision');
      end;
    end;
    for I:=0 to High(Bosses) do begin CrashRequire((Bosses[I].Source>=0) and (Bosses[I].Source<Length(Events)) and CrashFinite(Bosses[I].Spawn) and CrashFinite(Bosses[I].Ready) and CrashFinite(Bosses[I].Kill) and (Bosses[I].Spawn<Bosses[I].Ready) and (Bosses[I].Ready<Bosses[I].Kill) and (Bosses[I].Kill=Events[Bosses[I].Source].Time),'boss source');
      if I>0 then CrashRequire(Bosses[I].Ready>Bosses[I-1].Kill,'boss order');
      CrashRequire((Bosses[I].Enemy>=0) and (Bosses[I].Enemy<Length(Enemies)),'boss link');
      E:=Enemies[Bosses[I].Enemy];
      CrashRequire((E.Boss=I) and (E.Last>E.First) and (Hits[E.Last].Time=Bosses[I].Kill) and (Hits[E.Last].HP=0),'boss final');
    end;
    ValidateTrafficContacts(Plan,Cancel);
  end;
end;

function RaceCrashJSON(Plan:TRaceCrashMotion):TJSONObject;
var
  A,R:TJSONArray;
  V:TRhythmHit;
  H:TCrashHit;
  E:TCrashEnemy;
  T:TCrashTraffic;
  K:TCrashKey;
  B:TCrashBoss;
  S:TCrashShunt;
  procedure Row(const Values:array of Double);
  var
    D:Double;
    Bits:UInt64;
  begin R:=TJSONArray.Create;
    A.AddElement(R);
    for D in Values do begin Move(D,Bits,8);
      R.Add(IntToHex(Bits,16));
    end;
  end;
begin
  with Plan do begin
    Result:=TJSONObject.Create;
    Result.AddPair('policy','inverse-ram-traffic-v'+IntToStr(Version));
    A:=TJSONArray.Create;
    Result.AddPair('meta',A);
    Row([Duration,SoundEnd,EndTime,Launch,Acceleration,Goal,TopSpeed,Frequency]);
    A:=TJSONArray.Create;
    Result.AddPair('events',A);
    for V in Events do Row([V.Time,V.Strength]);
    A:=TJSONArray.Create;
    Result.AddPair('hits',A);
    for H in Hits do Row([H.Time,H.Strength,H.Distance,H.Lane,H.Source,H.Enemy,H.HP]);
    A:=TJSONArray.Create;
    Result.AddPair('enemies',A);
    for E in Enemies do if Version>=10 then Row([E.Spawn,E.Ready,E.Kill,E.Clear,E.Width,E.HalfLength,E.Speed,E.First,E.Last,E.Kind,E.Boss,E.Side,E.ApproachLane])
    else Row([E.Spawn,E.Ready,E.Kill,E.Clear,E.Width,E.HalfLength,E.Speed,E.First,E.Last,E.Kind,E.Boss,E.Side]);
    A:=TJSONArray.Create;
    Result.AddPair('traffic',A);
    for T in Traffic do if Version>=10 then Row([T.Spawn,T.Clear,T.Pass,T.RelativeSpeed,T.Width,T.HalfLength,T.Gap,T.FarLane,T.Side,T.Kind,T.TurnStart,T.TurnFinish,T.NearLane])
    else Row([T.Spawn,T.Clear,T.Pass,T.RelativeSpeed,T.Width,T.HalfLength,T.Gap,T.FarLane,T.Side,T.Kind]);
    A:=TJSONArray.Create;
    Result.AddPair('keys',A);
    for K in Keys do Row([K.Time,K.Value]);
    A:=TJSONArray.Create;
    Result.AddPair('road',A);
    for K in Road do Row([K.Time,K.Value]);
    A:=TJSONArray.Create;
    Result.AddPair('bosses',A);
    for B in Bosses do Row([B.Spawn,B.Ready,B.Kill,B.Source,B.Enemy]);
    if Version>=9 then begin
      A:=TJSONArray.Create;
      Result.AddPair('shunts',A);
      for S in Shunts do Row([S.Time,S.Distance,S.Lane,S.Traffic,S.Enemy,S.Side]);
    end;
  end;
end;

procedure ReadRaceCrashJSON(Plan:TRaceCrashMotion;Root:TJSONObject;Audio:TRhythmAudio);
var
  A,R:TJSONArray;
  I:Integer;
  function Table(const Name:string;Limit:Integer):TJSONArray;
  begin Result:=Root.GetValue<TJSONArray>(Name);
    CrashRequire((Result<>nil) and (Result.Count<=Limit),'JSON '+Name);
  end;
  procedure Row(Count:Integer);
  begin CrashRequire(A.Items[I] is TJSONArray,'JSON row');
    R:=TJSONArray(A.Items[I]);
    CrashRequire(R.Count=Count,'JSON columns');
  end;
  function V(N:Integer):Double;
  var
    Bits:UInt64;
  begin CrashRequire((R.Items[N] is TJSONString) and (Length(R.Items[N].Value)=16) and TryStrToUInt64('$'+R.Items[N].Value,Bits),'JSON binary64');
    Move(Bits,Result,8);
    CrashRequire(CrashFinite(Result),'JSON finite');
  end;
  function Int(N,Lo,Hi:Integer):Integer;
  var
    D:Double;
  begin D:=V(N);
    CrashRequire((D>=Lo) and (D<=Hi) and (Frac(D)=0),'JSON integer');
    Result:=Trunc(D);
  end;
begin CrashRequire((Root<>nil) and ((Root.GetValue<string>('policy','')='inverse-ram-traffic-v8') or (Root.GetValue<string>('policy','')='inverse-ram-traffic-v9') or (Root.GetValue<string>('policy','')='inverse-ram-traffic-v10')),'JSON policy');
  Plan.Version:=8;
  if Root.GetValue<string>('policy','')='inverse-ram-traffic-v9' then Plan.Version:=9;
  if Root.GetValue<string>('policy','')='inverse-ram-traffic-v10' then Plan.Version:=10;
  A:=Table('meta',1);
  CrashRequire(A.Count=1,'JSON header');
  I:=0;
  Row(8);
  Plan.Duration:=V(0);
  Plan.SoundEnd:=V(1);
  Plan.EndTime:=V(2);
  Plan.Launch:=V(3);
  Plan.Acceleration:=V(4);
  Plan.Goal:=V(5);
  Plan.TopSpeed:=V(6);
  Plan.Frequency:=Int(7,0,100);
  CrashRequire((Abs(Plan.Duration-Audio.Duration)<1E-6) and (Abs(Plan.SoundEnd-Audio.SoundEnd)<1E-6),'audio identity');
  A:=Table('events',100000);
  CrashRequire(A.Count=Length(Audio.Hits),'audio event count');
  SetLength(Plan.Events,A.Count);
  for I:=0 to A.Count-1 do begin Row(2);
    Plan.Events[I].Time:=V(0);
    Plan.Events[I].Strength:=V(1);
  end;
  A:=Table('hits',100000);
  SetLength(Plan.Hits,A.Count);
  for I:=0 to A.Count-1 do begin Row(7);
    with Plan.Hits[I] do begin Time:=V(0);
      Strength:=V(1);
      Distance:=V(2);
      Lane:=V(3);
      Source:=Int(4,0,99999);
      Enemy:=Int(5,0,39999);
      HP:=Int(6,0,100000);
    end;
  end;
  A:=Table('enemies',40000);
  SetLength(Plan.Enemies,A.Count);
  for I:=0 to A.Count-1 do begin Row(12+Ord(Plan.Version>=10));
    with Plan.Enemies[I] do begin Spawn:=V(0);
      Ready:=V(1);
      Kill:=V(2);
      Clear:=V(3);
      Width:=V(4);
      HalfLength:=V(5);
      Speed:=V(6);
      First:=Int(7,0,99999);
      Last:=Int(8,0,99999);
      Kind:=Int(9,0,6);
      Boss:=Int(10,-1,63);
      Side:=Int(11,-1,1);
      if Plan.Version>=10 then ApproachLane:=V(12);
    end;
  end;
  A:=Table('traffic',24000);
  SetLength(Plan.Traffic,A.Count);
  for I:=0 to A.Count-1 do begin Row(10+3*Ord(Plan.Version>=10));
    with Plan.Traffic[I] do begin Spawn:=V(0);
      Clear:=V(1);
      Pass:=V(2);
      RelativeSpeed:=V(3);
      Width:=V(4);
      HalfLength:=V(5);
      Gap:=V(6);
      FarLane:=V(7);
      Side:=Int(8,-1,1);
      Kind:=Int(9,0,3);
      Shunt:=-1;
      if Plan.Version>=10 then begin TurnStart:=V(10);TurnFinish:=V(11);NearLane:=V(12);end;
    end;
  end;
  A:=Table('keys',40000);
  SetLength(Plan.Keys,A.Count);
  for I:=0 to A.Count-1 do begin Row(2);
    Plan.Keys[I].Time:=V(0);
    Plan.Keys[I].Value:=V(1);
  end;
  A:=Table('road',2000);
  SetLength(Plan.Road,A.Count);
  for I:=0 to A.Count-1 do begin Row(2);
    Plan.Road[I].Time:=V(0);
    Plan.Road[I].Value:=V(1);
  end;
  A:=Table('bosses',64);
  SetLength(Plan.Bosses,A.Count);
  for I:=0 to A.Count-1 do begin Row(5);
    with Plan.Bosses[I] do begin Spawn:=V(0);
      Ready:=V(1);
      Kill:=V(2);
      Source:=Int(3,0,99999);
      Enemy:=Int(4,-1,39999);
    end;
  end;
  if Plan.Version>=9 then begin
    A:=Table('shunts',24000);
    SetLength(Plan.Shunts,A.Count);
    for I:=0 to A.Count-1 do begin Row(6);
      with Plan.Shunts[I] do begin
        Time:=V(0);
        Distance:=V(1);
        Lane:=V(2);
        Traffic:=Int(3,0,23999);
        Enemy:=Int(4,0,39999);
        Side:=Int(5,-1,1);
        CrashRequire(Traffic<Length(Plan.Traffic),'JSON shunt car');
        CrashRequire(Plan.Traffic[Traffic].Shunt=-1,'JSON duplicate shunt');
        Plan.Traffic[Traffic].Shunt:=I;
      end;
    end;
  end;
  ValidateRaceCrashPlan(Plan,nil);
end;

end.
