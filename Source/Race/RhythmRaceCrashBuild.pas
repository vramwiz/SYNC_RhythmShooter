unit RhythmRaceCrashBuild;
// 音衝突→経路→敵→一般車の順で逆算する準備専用ビルダー。
interface
uses System.SysUtils,RhythmAudio,RhythmRaceCrashMotion;
// 呼出側が所有する空の計画を構築する。失敗時の破棄も呼出側の責務。
procedure BuildRaceCrashPlan(Plan:TRaceCrashMotion;Audio:TRhythmAudio;const Cancel:TFunc<Boolean>);
implementation
uses System.Math,System.Generics.Collections,System.Generics.Defaults,RhythmSections,RhythmRaceCrashCodec,RhythmRaceTrafficContacts,RhythmRaceTrafficPlan;

procedure BuildRaceCrashPlan(Plan:TRaceCrashMotion;Audio:TRhythmAudio;const Cancel:TFunc<Boolean>);
const
  Kinds:array[0..7]of Integer=(0,0,1,0,2,0,3,0);
  Widths:array[0..6]of Double=(0.12,0.24,0.26,0.32,0.26,0.28,0.28);
  Lengths:array[0..6]of Double=(6,13,16,24,22,24,28);
  AdmissionWidths:array[0..3]of Double=(0.105,0.13,0.16,0.20);
var
  BL:TList<TCrashBoss>;
  HL:TList<TCrashHit>;
  EL:TList<TCrashEnemy>;
  TL:TList<TCrashTraffic>;
  KL,RL,Wanted:TList<TCrashKey>;
  Selected:TList<Integer>;
  I,J,Q,N,A,B,Best,BI,Kind,Ordinal,Side,FixedCount,Prev:Integer;
  Start,Stop,Last,T,Gap,UntilTime,Span,Target,LaneLow,LaneHigh,Extra,Near,Pass,Mean:Double;
  H:TCrashHit;
  E:TCrashEnemy;
  V:TCrashTraffic;
  Boss:TCrashBoss;
  K,Old:TCrashKey;
  Cue:TRhythmBossCue;
  procedure Check;
  begin if Assigned(Cancel) and Cancel() then Abort;
  end;
  function RawBefore(Time:Double):Integer;
  var
    L,R,M:Integer;
  begin L:=0;
    R:=Length(Plan.Events);
    while L<R do begin M:=(L+R) div 2;
      if Plan.Events[M].Time<=Time then L:=M+1 else R:=M;
    end;
    Result:=L-1;
  end;
  procedure Want(Time,Value:Double);
  begin K.Time:=Time;
    K.Value:=Value;
    Wanted.Add(K);
  end;
  function NearAnchor(Time:Double):Boolean;
  var
    L,R,M:Integer;
  begin L:=0;
    R:=FixedCount;
    while L<R do begin M:=(L+R) div 2;
      if Wanted[M].Time<Time then L:=M+1 else R:=M;
    end;
    Result:=False;
    if L<FixedCount then Result:=Abs(Wanted[L].Time-Time)<0.70;
    if L>0 then Result:=Result or (Abs(Wanted[L-1].Time-Time)<0.70);
  end;
begin CrashRequire(Audio<>nil,'audio');
  CrashRequire(CrashFinite(Audio.Duration) and CrashFinite(Audio.SoundEnd) and (Audio.Duration>0) and (Audio.Duration<=CRASH_MAX_SECONDS) and (Audio.SoundEnd>=0) and (Audio.SoundEnd<=Audio.Duration) and (Length(Audio.Hits)<=100000),'audio bounds');
  BL:=TList<TCrashBoss>.Create;
  HL:=TList<TCrashHit>.Create;
  EL:=TList<TCrashEnemy>.Create;
  TL:=TList<TCrashTraffic>.Create;
  KL:=TList<TCrashKey>.Create;
  RL:=TList<TCrashKey>.Create;
  Wanted:=TList<TCrashKey>.Create;
  Selected:=TList<Integer>.Create;
  try
    Plan.Version:=10;
    Plan.Events:=Copy(Audio.Hits);
    Plan.Duration:=Audio.Duration;
    Plan.SoundEnd:=Audio.SoundEnd;
    Plan.Frequency:=Audio.BossFrequency;
    Plan.EndTime:=Audio.Duration;
    if Audio.SoundEnd>0 then Plan.EndTime:=Audio.SoundEnd;
    Plan.Launch:=Min(1.25,Plan.EndTime*0.10);
    Plan.Goal:=Plan.EndTime-Min(1.35,Plan.EndTime*0.15);
    Plan.Acceleration:=Min(1.8,(Plan.Goal-Plan.Launch)*0.25);
    Mean:=0;
    Last:=-1;
    for I:=0 to High(Plan.Events) do begin Check;
      CrashRequire(CrashFinite(Plan.Events[I].Time) and CrashFinite(Plan.Events[I].Strength) and (Plan.Events[I].Time>=Last) and (Plan.Events[I].Time>=0) and (Plan.Events[I].Time<=Audio.Duration+0.011),'source order');
      Last:=Plan.Events[I].Time;
      Mean:=Mean+EnsureRange(Plan.Events[I].Strength,0.0,1.0);
    end;
    Plan.TopSpeed:=135+24*Mean/Max(1,Length(Plan.Events));
    Start:=Plan.Launch+0.60*Plan.Acceleration;
    Stop:=Plan.Goal-Min(0.35,(Plan.Goal-Plan.Launch)*0.08);
    if (Plan.Frequency>0) and (Plan.SoundEnd>0) then for I:=0 to Min(64,Audio.BossCount)-1 do begin Check;
      Q:=I;
      if Audio.BossCount>64 then Q:=Round(I*(Audio.BossCount-1)/63);
      Cue:=Audio.BossCue(Q);
      A:=Audio.NearestHit(Max(Start,Cue.StartTime+0.7));
      B:=RawBefore(Min(Stop,Cue.KillTime));
      if (A<0) or (B<A+3) then Continue;
      Best:=B;
      J:=B;
      while J>=A do begin if Plan.Events[J].Time<Plan.Events[B].Time-1.2 then Break;
        if Plan.Events[J].Strength>Plan.Events[Best].Strength then Best:=J;
        Dec(J);
      end;
      B:=Best;
      if Plan.Events[B].Time-Plan.Events[A].Time<2 then Continue;
      Boss.Spawn:=Max(Plan.Launch*0.4,Cue.StartTime);
      Boss.Ready:=Plan.Events[A].Time;
      Boss.Kill:=Plan.Events[B].Time;
      Boss.Source:=B;
      Boss.Enemy:=-1;
      BL.Add(Boss);
    end;
    Plan.Bosses:=BL.ToArray;
    if (Length(Plan.Bosses)>0) and (Plan.Bosses[High(Plan.Bosses)].Kill>Stop-1.3) then Stop:=Plan.Bosses[High(Plan.Bosses)].Kill
    else begin B:=RawBefore(Min(Stop,Plan.SoundEnd));
      if B>=0 then begin Best:=B;
        J:=B;
        while J>=0 do begin if (Plan.Events[J].Time<Plan.Events[B].Time-1.0) or (Plan.Events[J].Time<Start) then Break;
          if Plan.Events[J].Strength>Plan.Events[Best].Strength then Best:=J;
          Dec(J);
        end;
        if Plan.Events[Best].Time>=Start then Stop:=Plan.Events[Best].Time;
      end;
    end;
    I:=0;
    while I<Length(Plan.Events) do begin Check;
      T:=Plan.Events[I].Time;
      if (T<Start) or (T>Stop) or (T>Plan.SoundEnd) then begin Inc(I);
        Continue;
      end;
      BI:=Plan.BossOf(T);
      Gap:=0.085;
      if BI>=0 then Gap:=0.50;
      UntilTime:=T+Gap;
      Best:=I;
      J:=I+1;
      while J<Length(Plan.Events) do begin if (Plan.Events[J].Time>=UntilTime) or (Plan.Events[J].Time>Stop) or (Plan.BossOf(Plan.Events[J].Time)<>BI) then Break;
        if Plan.Events[J].Strength>Plan.Events[Best].Strength then Best:=J;
        Inc(J);
      end;
      Selected.Add(Best);
      I:=J;
    end;
    for Boss in Plan.Bosses do Selected.Add(Boss.Source);
    Selected.Sort;
    Prev:=-1;
    for I in Selected do begin if I=Prev then Continue;
      Prev:=I;
      H:=Default(TCrashHit);
      H.Time:=Plan.Events[I].Time;
      H.Strength:=EnsureRange(Plan.Events[I].Strength,0.0,1.0);
      H.Source:=I;
      H.Enemy:=-1;
      HL.Add(H);
    end;
    Plan.Hits:=HL.ToArray;
    I:=0;
    Ordinal:=0;
    while I<Length(Plan.Hits) do begin Check;
      H:=Plan.Hits[I];
      BI:=Plan.BossOf(H.Time);
      J:=I;
      if BI>=0 then begin while J<High(Plan.Hits) do begin if Plan.BossOf(Plan.Hits[J+1].Time)<>BI then Break;
          Inc(J);
        end;
      end else while J<High(Plan.Hits) do begin if (Plan.BossOf(Plan.Hits[J+1].Time)>=0) or (Plan.Hits[J+1].Time-H.Time>0.36) or (Plan.Hits[J+1].Time-Plan.Hits[J].Time>0.24) then Break;
        Inc(J);
      end;
      Kind:=Kinds[Ordinal mod 8];
      if (J=High(Plan.Hits)) and (BI<0) then Kind:=3;
      if BI>=0 then Kind:=4+BI mod 3;
      E:=Default(TCrashEnemy);
      E.Spawn:=Max(Plan.Launch*0.4,H.Time-3.8);
      E.Ready:=H.Time;
      E.Kill:=Plan.Hits[J].Time;
      E.Clear:=Min(Plan.EndTime,E.Kill+0.90);
      E.Width:=Widths[Kind];
      E.HalfLength:=Lengths[Kind];
      E.First:=I;
      E.Last:=J;
      E.Kind:=Kind;
      E.Boss:=BI;
      if BI>=0 then begin // ボスは既存交通の出現距離より奥から接近し、車内への突然出現を避ける。
        E.Spawn:=Max(Plan.Launch*0.4,Min(Plan.Bosses[BI].Spawn,E.Ready-7.0));
        Plan.Bosses[BI].Spawn:=E.Spawn;
        Plan.Bosses[BI].Enemy:=EL.Count;
      end;
      EL.Add(E);
      for Q:=I to J do begin H:=Plan.Hits[Q];
        H.Enemy:=EL.Count-1;
        H.HP:=J-Q;
        Plan.Hits[Q]:=H;
        if BI>=0 then Want(H.Time,0.26*Sin((Q-I)*1.61+BI));
      end;
      if BI<0 then Want(E.Ready,0.48*Sin(Ordinal*1.71+0.8));
      Inc(Ordinal);
      I:=J+1;
    end;
    Plan.Enemies:=EL.ToArray;
    FixedCount:=Wanted.Count;
    T:=Plan.Launch+Plan.Acceleration+0.2;
    N:=0;
    while (Plan.SoundEnd>0) and (T<Stop) do begin Check;
      if not NearAnchor(T) then Want(T,0.44*Sin(N*1.7+1));
      T:=T+2.8;
      Inc(N);
    end;
    Want(0,0);
    Want(Plan.Launch,0);
    Wanted.Sort(TComparer<TCrashKey>.Construct(function(const A,B:TCrashKey):Integer begin Result:=0;if A.Time<B.Time then Result:=-1 else if A.Time>B.Time then Result:=1;end));
    for K in Wanted do begin if KL.Count>0 then begin Old:=KL[KL.Count-1];
        if K.Time-Old.Time<1E-8 then Continue;
        Target:=EnsureRange(K.Value,Old.Value-0.65*(K.Time-Old.Time),Old.Value+0.65*(K.Time-Old.Time));
      end else Target:=0;
      Old.Time:=K.Time;
      Old.Value:=Target;
      KL.Add(Old);
    end;
    K:=KL[KL.Count-1];
    if K.Time<Plan.Goal then begin K.Time:=Plan.Goal;
      KL.Add(K);
    end;
    K.Time:=Plan.EndTime;
    KL.Add(K);
    Plan.Keys:=KL.ToArray;
    N:=Ceil((Plan.DistanceAt(Plan.EndTime)+1500)/720);
    for I:=0 to N do begin Check;
      K.Time:=I*720;
      K.Value:=EnsureRange(0.22*Sin(I*1.13)+0.08*Sin(I*0.43),-0.28,0.28);
      RL.Add(K);
    end;
    Plan.Road:=RL.ToArray;
    for I:=0 to High(Plan.Enemies) do begin Check;
      E:=Plan.Enemies[I];
      Span:=E.Ready-E.Spawn;
      if Span>0 then E.Speed:=0.38*(Plan.DistanceAt(E.Ready)-Plan.DistanceAt(E.Spawn))/Span;
      if (E.Boss<0) and (I mod 3<>0) then begin Side:=1;
        if Plan.LaneAt(E.Ready)>=0 then Side:=-1;
        Plan.LaneBounds(E.Spawn,E.Kill,LaneLow,LaneHigh);
        Extra:=CRASH_HERO_WIDTH+2*E.Width+0.04;
        if ((Side>0) and (LaneHigh+Extra<=0.999)) or ((Side<0) and (LaneLow-Extra>=-0.999)) then E.Side:=Side;
      end;
      E.ApproachLane:=EnsureRange(Plan.LaneAt(E.Ready)+E.Side*(Plan.HeroWidth+E.Width)+0.28*Sin(I*0.91),-1+E.Width,1-E.Width);
      if E.Side<>0 then begin
        Plan.LaneBounds(E.Spawn,E.Ready,LaneLow,LaneHigh);
        if E.Side>0 then E.ApproachLane:=LaneHigh+Plan.HeroWidth+E.Width+0.04
        else E.ApproachLane:=LaneLow-Plan.HeroWidth-E.Width-0.04;
      end;
      Plan.Enemies[I]:=E;
      for J:=E.First to E.Last do begin H:=Plan.Hits[J];
        H.Distance:=Plan.DistanceAt(H.Time)+3;
        H.Lane:=Plan.LaneAt(H.Time)+E.Side*Plan.HeroWidth;
        if E.Side=0 then H.Distance:=Plan.DistanceAt(H.Time)+Plan.HeroFront;
        Plan.Hits[J]:=H;
      end;
    end;
    if Plan.SoundEnd>0 then begin Pass:=Plan.Launch+0.7*Plan.Acceleration+0.30;
      N:=0;
      while Pass<Plan.Goal-0.10 do begin Check;
        for Side:=-1 to 1 do begin if Side=0 then Continue;
          Kind:=N mod 4;
          if N mod 11=0 then Kind:=3;
          V:=Default(TCrashTraffic);
          V.Shunt:=-1;
          V.Kind:=Kind;
          V.Width:=0.085;
          V.HalfLength:=4.5;
          case Kind of 1:begin V.Width:=0.105;
              V.HalfLength:=6;
            end;
            2:begin V.Width:=0.125;
              V.HalfLength:=8;
            end;
            3:begin V.Width:=0.15;
              V.HalfLength:=14;
            end;
          end;
          Q:=N;
          if Side>0 then Inc(Q);
          case Q mod 4 of 0:V.RelativeSpeed:=65;
            1:V.RelativeSpeed:=95;
            2:V.RelativeSpeed:=140;
            3:V.RelativeSpeed:=170;
          end;
          V.Gap:=0.018+0.004*(N mod 4);
          Near:=30/V.RelativeSpeed+0.10;
          Plan.LaneBounds(Max(Plan.Launch,Pass-Near),Min(Plan.EndTime,Pass+Near),LaneLow,LaneHigh);
          // 通過台数の採用条件はv8と同じ幅を使い、評価済みの交通量を維持する。
          Extra:=CRASH_HERO_WIDTH+2*AdmissionWidths[Kind]+V.Gap+0.04;
          if ((Side>0) and (LaneHigh+Extra>0.999)) or ((Side<0) and (LaneLow-Extra< -0.999)) then Continue;
          V.Spawn:=Max(Plan.Launch,Pass-2.8);
          V.Clear:=Min(Plan.EndTime,Pass+1.1);
          V.Pass:=Pass;
          V.Side:=Side;
          V.FarLane:=Side*(0.52+0.18*Sin(N*0.87));
          PlanTrafficLane(Plan,V,N*2+Ord(Side>0));
          TL.Add(V);
        end;
        Pass:=Pass+0.30;
        Inc(N);
      end;
    end;
    Plan.Traffic:=TL.ToArray;
    BuildTrafficContacts(Plan,Cancel);
    ValidateRaceCrashPlan(Plan,Cancel);
  finally Selected.Free;
    Wanted.Free;
    RL.Free;
    KL.Free;
    TL.Free;
    EL.Free;
    HL.Free;
    BL.Free;
  end;
end;

end.
