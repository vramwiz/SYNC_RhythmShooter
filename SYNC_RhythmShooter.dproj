        <DCCReference Include="Source\Lib\Process\MimiChildProcess.pas"/>
        <DCCReference Include="Source\Audio\RhythmAudio.pas"/>
        <DCCReference Include="Source\Audio\RhythmSections.pas"/>
        <DCCReference Include="Source\Audio\RhythmPlayback.pas"/>
        <DCCReference Include="Source\Engine\RhythmImageBank.pas"/>
        <DCCReference Include="Source\Engine\RhythmShootingAssets.pas"/>
        <DCCReference Include="Source\Engine\RhythmRenderSurface.pas"/>
